    <sys:String x:Key="Install.Failed">No se ha podido instalar: {0}</sys:String>
    <sys:String x:Key="Uninstall.Title">Desinstalar Open Control Edge</sys:String>
    <sys:String x:Key="Uninstall.Intro">Dejará de iniciarse con Windows y se cerrará. La carpeta del programa se borra al reiniciar; tus ajustes se quedan en %LOCALAPPDATA%\OpenControlEdge.</sys:String>
    <sys:String x:Key="Uninstall.Button">Desinstalar</sys:String>
    <sys:String x:Key="Uninstall.Working">Desinstalando…</sys:String>
    <sys:String x:Key="Uninstall.Done">Desinstalado. La carpeta del programa se borrará al reiniciar.</sys:String>
    <sys:String x:Key="Uninstall.Failed">No se ha podido desinstalar: {0}</sys:String>

    <!-- API keys window -->
    <sys:String x:Key="Keys.Title">Claves de API</sys:String>
    <sys:String x:Key="Keys.Intro">Se cifran con DPAPI para tu usuario de Windows. Nunca se guardan en settings ni en el registro.</sys:String>
    <sys:String x:Key="Keys.Save">Guardar</sys:String>
