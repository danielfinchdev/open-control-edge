    <sys:String x:Key="Msg.ClaudeCliMissing">No se encuentra Claude Code: instálalo para renovar desde aquí</sys:String>
    <sys:String x:Key="Msg.ClaudeCliTimeout">Claude Code no ha respondido en 60 s</sys:String>
    <sys:String x:Key="Msg.ClaudeCliStartFailed">No se pudo iniciar Claude Code sin privilegios de administrador</sys:String>
    <sys:String x:Key="Msg.ClaudeNotRenewed">Claude Code no ha renovado la sesión: ábrelo e inicia sesión</sys:String>
