    <sys:String x:Key="Menu.Uninstall">Desinstalar…</sys:String>

    <!-- Welcome / install and uninstall window -->
    <sys:String x:Key="Install.Title">Instalar Open Control Edge</sys:String>
    <sys:String x:Key="Install.Intro">Open Control Edge se instalará en Archivos de programa, donde solo un administrador puede modificarlo, y arrancará solo al iniciar sesión, sin volver a pedir permiso.</sys:String>
    <sys:String x:Key="Install.Step.Stop">Cerrar la versión en marcha (también EdgeWidget)</sys:String>
    <sys:String x:Key="Install.Step.Copy">Copiar la aplicación a C:\Program Files\OpenControlEdge y comprobarla</sys:String>
    <sys:String x:Key="Install.Step.Data">Proteger tus ajustes y conservar los de versiones anteriores</sys:String>
    <sys:String x:Key="Install.Step.Task">Iniciar con Windows y quitar las tareas antiguas</sys:String>
    <sys:String x:Key="Install.Step.Start">Abrir la copia instalada</sys:String>
    <sys:String x:Key="Install.Button">Instalar</sys:String>
    <sys:String x:Key="Install.Portable">Usar sin instalar</sys:String>
    <sys:String x:Key="Install.Cancel">Cancelar</sys:String>
    <sys:String x:Key="Install.Retry">Reintentar</sys:String>
    <sys:String x:Key="Install.Close">Cerrar</sys:String>
    <sys:String x:Key="Install.Working">Instalando…</sys:String>
