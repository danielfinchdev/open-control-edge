<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Spanish texts. Strings.en.xaml must define exactly the same keys. -->

    <!-- Card titles -->
    <sys:String x:Key="Card.Claude">Uso de Claude</sys:String>
    <sys:String x:Key="Card.Codex">Uso de Codex</sys:String>
    <sys:String x:Key="Card.Cursor">Uso de Cursor</sys:String>
    <sys:String x:Key="Card.OpenCode">Uso de OpenCode</sys:String>
    <sys:String x:Key="Card.DeepSeek">Uso de DeepSeek</sys:String>
    <sys:String x:Key="Card.OpenRouter">Uso de OpenRouter</sys:String>
    <sys:String x:Key="Card.Since">desde las {0:HH:mm}</sys:String>

    <!-- Tabs inside the card -->
    <sys:String x:Key="Tab.Session">Sesión</sys:String>
    <sys:String x:Key="Tab.Total">Total</sys:String>

    <!-- Card rows -->
    <sys:String x:Key="Row.CurrentSession">Sesión actual</sys:String>
    <sys:String x:Key="Row.Weekly">Semanal</sys:String>
    <sys:String x:Key="Row.Spent">Gastado</sys:String>
    <sys:String x:Key="Row.MonthlyCycle">Ciclo mensual</sys:String>
    <sys:String x:Key="Row.OnDemand">Bajo demanda</sys:String>
    <sys:String x:Key="Row.InputTokens">Tokens de entrada</sys:String>
    <sys:String x:Key="Row.OutputTokens">Tokens de salida</sys:String>
    <sys:String x:Key="Row.ReasoningTokens">Tokens de razonamiento</sys:String>
    <sys:String x:Key="Row.Cache">Caché (lectura / escritura)</sys:String>
    <sys:String x:Key="Row.TotalCost">Coste acumulado</sys:String>
    <sys:String x:Key="Row.Balance">Saldo restante</sys:String>
    <sys:String x:Key="Row.Spend">Gasto</sys:String>
    <sys:String x:Key="Row.LimitUsage">Uso del límite</sys:String>
    <sys:String x:Key="Row.TotalSpend">Gasto acumulado</sys:String>
    <sys:String x:Key="Row.LimitRemaining">Límite restante</sys:String>
    <sys:String x:Key="Row.Temperature">Temperatura</sys:String>
    <sys:String x:Key="Row.SessionMax">Máxima de la sesión</sys:String>
    <sys:String x:Key="Row.CpuLoad">Carga de CPU</sys:String>
    <sys:String x:Key="Row.GpuLoad">Uso</sys:String>
    <sys:String x:Key="Row.MemoryUsed">Memoria usada</sys:String>

    <!-- Values -->
    <sys:String x:Key="Value.Used">{0} usado</sys:String>
    <sys:String x:Key="Value.InUse">{0} en uso</sys:String>
    <sys:String x:Key="Value.Of">{0} de {1}</sys:String>
    <sys:String x:Key="Value.NoData">Sin datos</sys:String>
    <sys:String x:Key="Value.Renewing">Renovando la sesión…</sys:String>
    <sys:String x:Key="Ring.InstallPawnIo">Instala PawnIO para ver la temperatura</sys:String>

    <!-- Usage windows (Codex) and plans -->
    <sys:String x:Key="Window.Session">Sesión</sys:String>
    <sys:String x:Key="Window.Daily">Diario</sys:String>
    <sys:String x:Key="Window.Weekly">Semanal</sys:String>
    <sys:String x:Key="Window.Monthly">Mensual</sys:String>
    <sys:String x:Key="Window.Days">Límite de {0} días</sys:String>
    <sys:String x:Key="Window.Hours">Límite de {0} h</sys:String>
    <sys:String x:Key="Window.Limit">Límite</sys:String>
    <sys:String x:Key="Plan.Trial">Prueba</sys:String>

    <!-- Resets: {0} hours, {1} minutes; {0} day, {1} time -->
    <sys:String x:Key="Reset.Now">Se reinicia ahora</sys:String>
    <sys:String x:Key="Reset.InHours">Se reinicia en {0} h {1:00} min</sys:String>
    <sys:String x:Key="Reset.InMinutes">Se reinicia en {0} min</sys:String>
    <sys:String x:Key="Reset.On">Se reinicia el {0}, {1}</sys:String>
    <sys:String x:Key="Reset.DayFormat">ddd d</sys:String>
    <sys:String x:Key="Reset.DateFormat">d MMM</sys:String>
    <sys:String x:Key="Reset.TimeFormat">HH:mm</sys:String>

    <!-- Panel buttons and tooltips -->
    <sys:String x:Key="Tip.ClaudeRing">Renovar la sesión de Claude y abrir Claude Code</sys:String>
    <sys:String x:Key="Tip.Hide">Ocultar en el borde</sys:String>
    <sys:String x:Key="Tip.Pin">Fijar el panel</sys:String>
    <sys:String x:Key="Tip.Settings">Ajustes</sys:String>
    <sys:String x:Key="Tip.Close">Cerrar Open Control Edge</sys:String>

    <!-- Tray menu -->
    <sys:String x:Key="Menu.Refresh">Actualizar ahora</sys:String>
    <sys:String x:Key="Menu.ApiKeys">Claves de API…</sys:String>
    <sys:String x:Key="Menu.Exit">Salir</sys:String>

    <!-- API keys window -->
    <sys:String x:Key="Keys.Title">Claves de API</sys:String>
    <sys:String x:Key="Keys.Intro">Se cifran con DPAPI para tu usuario de Windows. Nunca se guardan en settings ni en el registro.</sys:String>
    <sys:String x:Key="Keys.Save">Guardar</sys:String>
    <sys:String x:Key="Keys.Delete">Borrar</sys:String>
    <sys:String x:Key="Keys.Close">Cerrar</sys:String>
    <sys:String x:Key="Keys.Saved">Guardada</sys:String>
    <sys:String x:Key="Keys.None">Sin clave</sys:String>
    <sys:String x:Key="Keys.Empty">Escribe una clave</sys:String>
    <sys:String x:Key="Keys.SaveFailed">No se pudo guardar</sys:String>
    <sys:String x:Key="Keys.Deleted">Borrada</sys:String>
    <sys:String x:Key="Keys.DeleteFailed">No se pudo borrar</sys:String>

    <!-- Service messages (Loc.Message) -->
    <sys:String x:Key="Msg.Loading">Cargando…</sys:String>
    <sys:String x:Key="Msg.NoConnection">Sin conexión</sys:String>
    <sys:String x:Key="Msg.Timeout">Tiempo de espera agotado</sys:String>
    <sys:String x:Key="Msg.InvalidResponse">Respuesta no válida</sys:String>
    <sys:String x:Key="Msg.EmptyResponse">Respuesta sin datos</sys:String>
    <sys:String x:Key="Msg.NoUsageData">Respuesta sin datos de uso</sys:String>
    <sys:String x:Key="Msg.NoSessionData">Respuesta sin datos de sesión</sys:String>
    <sys:String x:Key="Msg.NoLocalData">Respuesta local sin datos</sys:String>
    <sys:String x:Key="Msg.UsageUnreadable">No se pudo leer el uso</sys:String>
    <sys:String x:Key="Msg.LocalUsageUnreadable">No se pudo leer el uso local</sys:String>
    <sys:String x:Key="Msg.BalanceUnreadable">No se pudo leer el saldo</sys:String>
    <sys:String x:Key="Msg.NoSessionDatabase">Sin base de datos de sesiones</sys:String>
    <sys:String x:Key="Msg.OpenCodeUnsupported">Versión de OpenCode no compatible</sys:String>
    <sys:String x:Key="Msg.InstallOpenCode">Instala OpenCode para activar este anillo</sys:String>
    <sys:String x:Key="Msg.OpenCodeNotDetected">No se detecta OpenCode</sys:String>
    <sys:String x:Key="Msg.AddDeepSeekKey">Añade la clave API de DeepSeek</sys:String>
    <sys:String x:Key="Msg.AddOpenRouterKey">Añade la clave API de OpenRouter</sys:String>
    <sys:String x:Key="Msg.AddKeyFromMenu">Añade la clave API desde Claves de API…</sys:String>
    <sys:String x:Key="Msg.InvalidKey">Clave API no válida</sys:String>
    <sys:String x:Key="Msg.CursorBusy">Cursor ocupado, se reintentará</sys:String>
    <sys:String x:Key="Msg.ClaudeLogin">Inicia sesión en Claude Code</sys:String>
    <sys:String x:Key="Msg.CodexLogin">Inicia sesión en ChatGPT o Codex</sys:String>
    <sys:String x:Key="Msg.CursorLogin">Inicia sesión en Cursor</sys:String>
    <sys:String x:Key="Msg.ClaudeRenew">Abre Claude Code para renovar</sys:String>
    <sys:String x:Key="Msg.CodexRenew">Abre Codex para renovar</sys:String>
    <sys:String x:Key="Msg.FreeAccount">Cuenta gratuita: sin límites de uso medibles</sys:String>
    <sys:String x:Key="Msg.RenewTaskMissing">No se puede renovar: falta la tarea «Claude - Mantener sesion». Se instala con claude-sesion.ps1 -Instalar.</sys:String>
    <sys:String x:Key="Msg.RenewTaskFailed">No se puede renovar: la tarea «Claude - Mantener sesion» no ha arrancado</sys:String>
    <sys:String x:Key="Msg.RenewFailed">No se pudo renovar la sesión</sys:String>
    <sys:String x:Key="Msg.PawnIoMissing">PawnIO no está instalado</sys:String>
    <sys:String x:Key="Msg.SensorUnavailable">Sensor de temperatura no disponible</sys:String>
    <sys:String x:Key="Msg.NeedsAdmin">Requiere ejecutar como administrador</sys:String>
    <sys:String x:Key="Msg.Stopped">Detenido</sys:String>
    <sys:String x:Key="Msg.HttpError">Error HTTP {0}</sys:String>
</ResourceDictionary>
