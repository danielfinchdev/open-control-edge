    <!-- Outcomes of the Claude renewal and of "Liberar RAM"; {0} time, or MB -->
    <sys:String x:Key="Claude.Renewed">Sesión renovada: vale hasta las {0:HH:mm}.</sys:String>
    <sys:String x:Key="Claude.StillValid">Sesión vigente hasta las {0:HH:mm}. Claude Code la renueva en sus últimos 5 minutos.</sys:String>
