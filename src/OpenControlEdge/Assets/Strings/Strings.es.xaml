    <sys:String x:Key="Reset.DateFormat">d MMM</sys:String>
    <sys:String x:Key="Reset.TimeFormat">HH:mm</sys:String>

    <!-- Panel buttons and tooltips -->
    <sys:String x:Key="Tip.ClaudeRing">Renovar la sesión de Claude Code (sin abrir ninguna ventana)</sys:String>
    <sys:String x:Key="Tip.CpuRing">Abrir Información del sistema</sys:String>
    <sys:String x:Key="Tip.RamRing">Liberar RAM: recorta la memoria que los programas no están usando y vacía la caché en espera. Es una limpieza puntual, como en los móviles: Windows vuelve a llenar la caché en cuanto la necesita.</sys:String>
    <sys:String x:Key="Tip.Hide">Ocultar en el borde</sys:String>
    <sys:String x:Key="Tip.Pin">Fijar el panel</sys:String>
    <sys:String x:Key="Tip.Settings">Ajustes</sys:String>
    <sys:String x:Key="Tip.Close">Cerrar Open Control Edge</sys:String>

