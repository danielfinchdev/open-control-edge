    <sys:String x:Key="Ram.Disabled">Liberar RAM está desactivado en los ajustes.</sys:String>
    <sys:String x:Key="Ring.InstallPawnIo">Instala PawnIO para ver la temperatura</sys:String>

    <!-- Usage windows (Codex) and plans -->
    <sys:String x:Key="Window.Session">Sesión</sys:String>
    <sys:String x:Key="Window.Daily">Diario</sys:String>
    <sys:String x:Key="Window.Weekly">Semanal</sys:String>
