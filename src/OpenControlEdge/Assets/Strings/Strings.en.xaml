<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- English texts. Strings.es.xaml must define exactly the same keys. -->

    <!-- Card titles -->
    <sys:String x:Key="Card.Claude">Claude usage</sys:String>
    <sys:String x:Key="Card.Codex">Codex usage</sys:String>
    <sys:String x:Key="Card.Cursor">Cursor usage</sys:String>
    <sys:String x:Key="Card.OpenCode">OpenCode usage</sys:String>
    <sys:String x:Key="Card.DeepSeek">DeepSeek usage</sys:String>
    <sys:String x:Key="Card.OpenRouter">OpenRouter usage</sys:String>
    <sys:String x:Key="Card.Since">since {0:h:mm tt}</sys:String>

    <!-- Tabs inside the card -->
    <sys:String x:Key="Tab.Session">Session</sys:String>
    <sys:String x:Key="Tab.Total">Total</sys:String>

    <!-- Card rows -->
    <sys:String x:Key="Row.CurrentSession">Current session</sys:String>
    <sys:String x:Key="Row.Weekly">Weekly</sys:String>
    <sys:String x:Key="Row.Spent">Spent</sys:String>
    <sys:String x:Key="Row.MonthlyCycle">Monthly cycle</sys:String>
    <sys:String x:Key="Row.OnDemand">On demand</sys:String>
    <sys:String x:Key="Row.InputTokens">Input tokens</sys:String>
    <sys:String x:Key="Row.OutputTokens">Output tokens</sys:String>
    <sys:String x:Key="Row.ReasoningTokens">Reasoning tokens</sys:String>
    <sys:String x:Key="Row.Cache">Cache (read / write)</sys:String>
    <sys:String x:Key="Row.TotalCost">Total cost</sys:String>
    <sys:String x:Key="Row.Balance">Remaining balance</sys:String>
    <sys:String x:Key="Row.Spend">Spend</sys:String>
    <sys:String x:Key="Row.LimitUsage">Limit usage</sys:String>
    <sys:String x:Key="Row.TotalSpend">Total spend</sys:String>
    <sys:String x:Key="Row.LimitRemaining">Limit remaining</sys:String>
    <sys:String x:Key="Row.Temperature">Temperature</sys:String>
    <sys:String x:Key="Row.SessionMax">Session maximum</sys:String>
    <sys:String x:Key="Row.CpuLoad">CPU load</sys:String>
    <sys:String x:Key="Row.GpuLoad">Load</sys:String>
    <sys:String x:Key="Row.MemoryUsed">Memory used</sys:String>

    <!-- Values -->
    <sys:String x:Key="Value.Used">{0} used</sys:String>
    <sys:String x:Key="Value.InUse">{0} in use</sys:String>
    <sys:String x:Key="Value.Of">{0} of {1}</sys:String>
    <sys:String x:Key="Value.NoData">No data</sys:String>
    <sys:String x:Key="Value.Renewing">Renewing the session…</sys:String>
    <sys:String x:Key="Ring.InstallPawnIo">Install PawnIO to see the temperature</sys:String>

    <!-- Usage windows (Codex) and plans -->
    <sys:String x:Key="Window.Session">Session</sys:String>
    <sys:String x:Key="Window.Daily">Daily</sys:String>
    <sys:String x:Key="Window.Weekly">Weekly</sys:String>
    <sys:String x:Key="Window.Monthly">Monthly</sys:String>
    <sys:String x:Key="Window.Days">{0}-day limit</sys:String>
    <sys:String x:Key="Window.Hours">{0} h limit</sys:String>
    <sys:String x:Key="Window.Limit">Limit</sys:String>
    <sys:String x:Key="Plan.Trial">Trial</sys:String>

    <!-- Resets: {0} hours, {1} minutes; {0} day, {1} time -->
    <sys:String x:Key="Reset.Now">Resets now</sys:String>
    <sys:String x:Key="Reset.InHours">Resets in {0} h {1:00} min</sys:String>
    <sys:String x:Key="Reset.InMinutes">Resets in {0} min</sys:String>
    <sys:String x:Key="Reset.On">Resets {0}, {1}</sys:String>
    <sys:String x:Key="Reset.DayFormat">ddd d</sys:String>
    <sys:String x:Key="Reset.DateFormat">MMM d</sys:String>
    <sys:String x:Key="Reset.TimeFormat">h:mm tt</sys:String>

    <!-- Panel buttons and tooltips -->
    <sys:String x:Key="Tip.ClaudeRing">Renew the Claude session and open Claude Code</sys:String>
    <sys:String x:Key="Tip.Hide">Hide at the edge</sys:String>
    <sys:String x:Key="Tip.Pin">Pin the panel</sys:String>
    <sys:String x:Key="Tip.Settings">Settings</sys:String>
    <sys:String x:Key="Tip.Close">Quit Open Control Edge</sys:String>

    <!-- Tray menu -->
    <sys:String x:Key="Menu.Refresh">Refresh now</sys:String>
    <sys:String x:Key="Menu.ApiKeys">API keys…</sys:String>
    <sys:String x:Key="Menu.Exit">Quit</sys:String>

    <!-- API keys window -->
    <sys:String x:Key="Keys.Title">API keys</sys:String>
    <sys:String x:Key="Keys.Intro">Encrypted with DPAPI for your Windows user. Never stored in the settings file or the registry.</sys:String>
    <sys:String x:Key="Keys.Save">Save</sys:String>
    <sys:String x:Key="Keys.Delete">Delete</sys:String>
    <sys:String x:Key="Keys.Close">Close</sys:String>
    <sys:String x:Key="Keys.Saved">Saved</sys:String>
    <sys:String x:Key="Keys.None">No key</sys:String>
    <sys:String x:Key="Keys.Empty">Enter a key</sys:String>
    <sys:String x:Key="Keys.SaveFailed">Could not save</sys:String>
    <sys:String x:Key="Keys.Deleted">Deleted</sys:String>
    <sys:String x:Key="Keys.DeleteFailed">Could not delete</sys:String>

    <!-- Service messages (Loc.Message) -->
    <sys:String x:Key="Msg.Loading">Loading…</sys:String>
    <sys:String x:Key="Msg.NoConnection">No connection</sys:String>
    <sys:String x:Key="Msg.Timeout">Timed out</sys:String>
    <sys:String x:Key="Msg.InvalidResponse">Invalid response</sys:String>
    <sys:String x:Key="Msg.EmptyResponse">Empty response</sys:String>
    <sys:String x:Key="Msg.NoUsageData">Response without usage data</sys:String>
    <sys:String x:Key="Msg.NoSessionData">Response without session data</sys:String>
    <sys:String x:Key="Msg.NoLocalData">Local data is empty</sys:String>
    <sys:String x:Key="Msg.UsageUnreadable">Could not read usage</sys:String>
    <sys:String x:Key="Msg.LocalUsageUnreadable">Could not read local usage</sys:String>
    <sys:String x:Key="Msg.BalanceUnreadable">Could not read the balance</sys:String>
    <sys:String x:Key="Msg.NoSessionDatabase">No session database</sys:String>
    <sys:String x:Key="Msg.OpenCodeUnsupported">Unsupported OpenCode version</sys:String>
    <sys:String x:Key="Msg.InstallOpenCode">Install OpenCode to enable this ring</sys:String>
    <sys:String x:Key="Msg.OpenCodeNotDetected">OpenCode not detected</sys:String>
    <sys:String x:Key="Msg.AddDeepSeekKey">Add the DeepSeek API key</sys:String>
    <sys:String x:Key="Msg.AddOpenRouterKey">Add the OpenRouter API key</sys:String>
    <sys:String x:Key="Msg.AddKeyFromMenu">Add the API key from API keys…</sys:String>
    <sys:String x:Key="Msg.InvalidKey">Invalid API key</sys:String>
    <sys:String x:Key="Msg.CursorBusy">Cursor is busy, will retry</sys:String>
    <sys:String x:Key="Msg.ClaudeLogin">Sign in to Claude Code</sys:String>
    <sys:String x:Key="Msg.CodexLogin">Sign in to ChatGPT or Codex</sys:String>
    <sys:String x:Key="Msg.CursorLogin">Sign in to Cursor</sys:String>
    <sys:String x:Key="Msg.ClaudeRenew">Open Claude Code to renew</sys:String>
    <sys:String x:Key="Msg.CodexRenew">Open Codex to renew</sys:String>
    <sys:String x:Key="Msg.FreeAccount">Free account: no measurable usage limits</sys:String>
    <sys:String x:Key="Msg.RenewTaskMissing">Cannot renew: the “Claude - Mantener sesion” task is missing. Install it with claude-sesion.ps1 -Instalar.</sys:String>
    <sys:String x:Key="Msg.RenewTaskFailed">Cannot renew: the “Claude - Mantener sesion” task did not start</sys:String>
    <sys:String x:Key="Msg.RenewFailed">Could not renew the session</sys:String>
    <sys:String x:Key="Msg.PawnIoMissing">PawnIO is not installed</sys:String>
    <sys:String x:Key="Msg.SensorUnavailable">Temperature sensor not available</sys:String>
    <sys:String x:Key="Msg.NeedsAdmin">Requires running as administrator</sys:String>
    <sys:String x:Key="Msg.Stopped">Stopped</sys:String>
    <sys:String x:Key="Msg.HttpError">HTTP error {0}</sys:String>
</ResourceDictionary>
