<Window x:Class="OpenControlEdge.Views.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:OpenControlEdge.Ui"
        Title="Open Control Edge"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale">

    <!-- 20 px margin leaves room for the shadow (TrayMenuWindow.ShadowMargin). -->
    <Grid Margin="20">
        <Border CornerRadius="14" Background="{DynamicResource Theme.Menu}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Color="Black" Opacity="0.5" />
            </Border.Effect>
        </Border>

        <Border x:Name="MenuBody" CornerRadius="14" Background="{DynamicResource Theme.Menu}" BorderBrush="{DynamicResource Theme.Border}"
                BorderThickness="1" Padding="6">
            <StackPanel MinWidth="196">
                <TextBlock Text="Open Control Edge" FontSize="12" Foreground="{DynamicResource Theme.TextSecondary}" Margin="12,6,12,6" />

                <Button x:Name="RefreshButton" Style="{StaticResource MenuButton}" Click="OnRefreshClick"
                        AutomationProperties.AutomationId="RefreshButton" AutomationProperties.Name="{DynamicResource Menu.Refresh}">
                    <StackPanel Orientation="Horizontal">
                        <ui:IconView Icon="{x:Static ui:Icons.Refresh}" Style="{StaticResource MenuIcon}" />
                        <TextBlock Text="{DynamicResource Menu.Refresh}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="ApiKeysButton" Style="{StaticResource MenuButton}" Click="OnApiKeysClick"
                        AutomationProperties.AutomationId="ApiKeysButton" AutomationProperties.Name="{DynamicResource Menu.ApiKeys}">
                    <StackPanel Orientation="Horizontal">
                        <ui:IconView Icon="{x:Static ui:Icons.Key}" Style="{StaticResource MenuIcon}" />
                        <TextBlock Text="{DynamicResource Menu.ApiKeys}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Installed copy only, until the settings window takes them over (see AutoStartService). -->
                <StackPanel x:Name="InstallEntries">
                    <Button x:Name="AutoStartButton" Style="{StaticResource MenuButton}" Click="OnAutoStartClick"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="AutoStartButton" AutomationProperties.Name="{DynamicResource Menu.AutoStart}">
                        <DockPanel>
                            <!-- On / off switch. -->
                            <Border x:Name="AutoStartSwitch" DockPanel.Dock="Right" Width="28" Height="16" CornerRadius="8"
                                    Background="{DynamicResource Theme.Raised}" Margin="14,0,0,0" VerticalAlignment="Center">
                                <Ellipse x:Name="AutoStartKnob" Width="12" Height="12" Margin="2,0" Fill="{DynamicResource Theme.TextSecondary}"
                                         HorizontalAlignment="Left" />
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <ui:IconView Icon="{x:Static ui:Icons.Gear}" Style="{StaticResource MenuIcon}" />
                                <TextBlock Text="{DynamicResource Menu.AutoStart}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                    </Button>

                    <Button x:Name="UninstallButton" Style="{StaticResource MenuButton}" Click="OnUninstallClick"
                            AutomationProperties.AutomationId="UninstallButton" AutomationProperties.Name="{DynamicResource Menu.Uninstall}">
                        <StackPanel Orientation="Horizontal">
                            <ui:IconView Icon="{x:Static ui:Icons.Close}" Style="{StaticResource MenuIcon}" />
                            <TextBlock Text="{DynamicResource Menu.Uninstall}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Height="1" Background="{DynamicResource Theme.Border}" Margin="10,4" />

                <Button x:Name="ExitButton" Style="{StaticResource MenuButton}" Click="OnExitClick"
                        AutomationProperties.AutomationId="ExitButton" AutomationProperties.Name="{DynamicResource Menu.Exit}">
                    <StackPanel Orientation="Horizontal">
                        <ui:IconView Icon="{x:Static ui:Icons.Power}" Style="{StaticResource MenuIcon}" />
                        <TextBlock Text="{DynamicResource Menu.Exit}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
