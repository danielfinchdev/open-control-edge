<Window x:Class="OpenControlEdge.Views.EdgeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:OpenControlEdge.Ui"
        Title="Open Control Edge"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        Focusable="False"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource Theme.Text}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale">

    <!-- Host is what the snapshot mode renders. Root is laid out in design units (the original design scaled to 85 %) and
         RootScale fits it to the monitor (see EdgeWindow.ApplyScale). -->
    <Grid x:Name="Host">
    <Canvas x:Name="Root" ClipToBounds="True" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Canvas.LayoutTransform>
            <ScaleTransform x:Name="RootScale" />
        </Canvas.LayoutTransform>

        <!-- Auto mode, collapsed: 5 DIP strip on the right edge (hover target; its width undoes the scale). -->
        <Rectangle x:Name="Strip" Width="5" Height="400" Fill="#99808080" />

        <!-- Detail card (to the left of the panel). -->
        <Grid x:Name="Card" Opacity="0" IsHitTestVisible="False">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="CardShift" />
            </Grid.RenderTransform>

            <!-- No DropShadowEffect: the beak moves on every ring switch and the effect would re-rasterise each frame. -->
            <ui:CardShape x:Name="CardBackground" Fill="{DynamicResource Theme.Background}" CornerRadius="20" BeakLength="16" BeakHalfHeight="15" />

            <Border x:Name="ContentClip" ClipToBounds="True" Margin="0,0,16,0">
                <Grid x:Name="CardContent" Margin="16,15,16,15" VerticalAlignment="Top">

                    <!-- Claude -->
                    <StackPanel x:Name="ClaudeCard">
                        <!-- Header: icon, title and plan badge, then the "Sesión | Total" tabs. -->
                        <DockPanel>
                            <Button x:Name="ClaudeInfo" DockPanel.Dock="Right" Style="{StaticResource CardInfoButton}" Margin="6,0,0,0"
                                    Click="OnInfoClick" AutomationProperties.AutomationId="ClaudeInfo" />
                            <StackPanel Orientation="Horizontal">
                                <ui:IconView Icon="{x:Static ui:Icons.ClaudeSpark}" Style="{StaticResource CardIcon}" />
                                <TextBlock Text="{DynamicResource Card.Claude}" Style="{StaticResource CardTitle}" Margin="9,0,0,0" />
                                <Border x:Name="ClaudePlan" Style="{StaticResource PlanBadge}">
                                    <TextBlock x:Name="ClaudePlanText" Style="{StaticResource PlanBadgeText}" />
                                </Border>
                                <!-- With more than one account (Ajustes › Agentes): one tag per account instead of the
                                     plan badge; a click switches account (EdgeWindow.SetAccounts). -->
                                <StackPanel x:Name="ClaudeAccountBadges" Orientation="Horizontal" Margin="2,0,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </DockPanel>
                        <!-- More than MaxTagsBesideTitle accounts: their tags go here, under the title, wrapping. -->
                        <WrapPanel x:Name="ClaudeAccountRow" Margin="-4,6,0,0" Visibility="Collapsed" />
                        <Border x:Name="ClaudeTabs" Style="{StaticResource UsageTabList}">
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="ClaudeSessionTab" Style="{StaticResource UsageTab}" Content="{DynamicResource Tab.Session}"
                                             GroupName="ClaudeView" AutomationProperties.AutomationId="ClaudeSessionTab" Checked="OnUsageViewChecked" />
                                <RadioButton x:Name="ClaudeTotalTab" Style="{StaticResource UsageTab}" Content="{DynamicResource Tab.Total}"
                                             GroupName="ClaudeView" AutomationProperties.AutomationId="ClaudeTotalTab" Checked="OnUsageViewChecked" />
                            </UniformGrid>
                        </Border>

                        <!-- Only the row of the selected tab is shown. -->
                        <StackPanel x:Name="ClaudeMetrics" Margin="0,11,0,0">
                            <StackPanel x:Name="ClaudeSessionRow">
                                <DockPanel>
                                    <TextBlock x:Name="ClaudeHeaderReset" DockPanel.Dock="Right" Style="{StaticResource SecondaryText}" Margin="10,0,0,0" />
                                    <TextBlock Text="{DynamicResource Row.CurrentSession}" Style="{StaticResource RowLabel}" />
                                </DockPanel>
                                <ui:LinearBar x:Name="SessionBar" Height="4" Margin="0,6,0,0" />
                                <TextBlock x:Name="SessionValue" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                            </StackPanel>

                            <StackPanel x:Name="ClaudeWeeklyRow" Visibility="Collapsed">
                                <DockPanel>
                                    <TextBlock x:Name="WeeklyReset" DockPanel.Dock="Right" Style="{StaticResource SecondaryText}" Margin="10,0,0,0" />
                                    <TextBlock Text="{DynamicResource Row.Weekly}" Style="{StaticResource RowLabel}" />
                                </DockPanel>
                                <ui:LinearBar x:Name="WeeklyBar" Height="4" Margin="0,6,0,0" />
                                <TextBlock x:Name="WeeklyValue" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                            </StackPanel>

                            <!-- Usage credits spent (spend.used), only above zero. The endpoint carries no remaining balance. -->
                            <DockPanel x:Name="ClaudeSpendRow" Margin="0,11,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="ClaudeSpendValue" DockPanel.Dock="Right" Style="{StaticResource ValueText}" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Row.Spent}" Style="{StaticResource RowLabel}" VerticalAlignment="Center" />
                            </DockPanel>
                            <!-- Orb's reading, shown because OCE has none of its own (App.WithOrbUsage). -->
                            <TextBlock x:Name="ClaudeSource" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,9,0,0" Visibility="Collapsed" />
                        </StackPanel>

                        <!-- An earlier reading kept after HTTP 429 / 5xx (ClaudeSnapshot.StaleSince): how old it is. -->
                        <TextBlock x:Name="ClaudeStale" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                   Margin="0,9,0,0" Visibility="Collapsed" />

                        <TextBlock x:Name="ClaudeMessage" Style="{StaticResource ValueText}" TextWrapping="Wrap"
                                   Margin="0,11,0,0" Visibility="Collapsed" />

                        <!-- Outcome of the last renewal (App.RenewClaudeSessionAsync); cleared after a while. -->
                        <TextBlock x:Name="ClaudeNote" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                   Margin="0,11,0,0" Visibility="Collapsed" />
                        <!-- "Abrir Claude": its app, or its web page (AppLauncher). -->
                        <Button x:Name="ClaudeOpen" Style="{StaticResource CardRoundButton}" HorizontalAlignment="Right" Margin="0,10,0,0"
                                Click="OnOpenClick" AutomationProperties.AutomationId="ClaudeOpen">
                            <ui:IconView Icon="{x:Static ui:Icons.OpenApp}" Width="13" Height="13" Foreground="{DynamicResource Theme.Text}" />
                        </Button>
                    </StackPanel>

                    <!-- Codex: the window of the selected tab (shorter for "Sesión", longer for "Total"), labelled by
                         its length. With a single window the tabs are hidden. -->
                    <StackPanel x:Name="CodexCard" Visibility="Collapsed">
                        <DockPanel>
                            <Button x:Name="CodexInfo" DockPanel.Dock="Right" Style="{StaticResource CardInfoButton}" Margin="6,0,0,0"
                                    Click="OnInfoClick" AutomationProperties.AutomationId="CodexInfo" />
                            <StackPanel Orientation="Horizontal">
                                <ui:IconView Icon="{x:Static ui:Icons.Codex}" Style="{StaticResource CardIcon}" />
                                <TextBlock Text="{DynamicResource Card.Codex}" Style="{StaticResource CardTitle}" Margin="9,0,0,0" />
                                <Border x:Name="CodexPlan" Style="{StaticResource PlanBadge}">
                                    <TextBlock x:Name="CodexPlanText" Style="{StaticResource PlanBadgeText}" />
                                </Border>
                                <!-- With more than one account (Ajustes › Agentes): one tag per account instead of the
                                     plan badge; a click switches account (EdgeWindow.SetAccounts). -->
                                <StackPanel x:Name="CodexAccountBadges" Orientation="Horizontal" Margin="2,0,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </DockPanel>
                        <!-- More than MaxTagsBesideTitle accounts: their tags go here, under the title, wrapping. -->
                        <WrapPanel x:Name="CodexAccountRow" Margin="-4,6,0,0" Visibility="Collapsed" />
                        <Border x:Name="CodexTabs" Style="{StaticResource UsageTabList}" Visibility="Collapsed">
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="CodexSessionTab" Style="{StaticResource UsageTab}" Content="{DynamicResource Tab.Session}"
                                             GroupName="CodexView" AutomationProperties.AutomationId="CodexSessionTab" Checked="OnUsageViewChecked" />
                                <RadioButton x:Name="CodexTotalTab" Style="{StaticResource UsageTab}" Content="{DynamicResource Tab.Total}"
                                             GroupName="CodexView" AutomationProperties.AutomationId="CodexTotalTab" Checked="OnUsageViewChecked" />
                            </UniformGrid>
                        </Border>

                        <StackPanel x:Name="CodexMetrics" Margin="0,11,0,0">
                            <DockPanel>
                                <TextBlock x:Name="CodexReset" DockPanel.Dock="Right" Style="{StaticResource SecondaryText}" Margin="10,0,0,0" />
                                <TextBlock x:Name="CodexWindowLabel" Style="{StaticResource RowLabel}" />
                            </DockPanel>
                            <ui:LinearBar x:Name="CodexBar" Height="4" Margin="0,6,0,0" />
                            <TextBlock x:Name="CodexValue" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />

                            <!-- credits of wham/usage, only when has_credits is true. -->
                            <DockPanel x:Name="CodexCreditsRow" Margin="0,11,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="CodexCreditsValue" DockPanel.Dock="Right" Style="{StaticResource ValueText}" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Row.Credits}" Style="{StaticResource RowLabel}" VerticalAlignment="Center" />
                            </DockPanel>
                            <!-- Orb's reading, shown because OCE has none of its own (App.WithOrbUsage). -->
                            <TextBlock x:Name="CodexSource" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,9,0,0" Visibility="Collapsed" />
                        </StackPanel>

                        <TextBlock x:Name="CodexMessage" Style="{StaticResource ValueText}" TextWrapping="Wrap"
                                   Margin="0,11,0,0" Visibility="Collapsed" />
                        <!-- "Abrir Codex": its app, or its web page (AppLauncher). -->
                        <Button x:Name="CodexOpen" Style="{StaticResource CardRoundButton}" HorizontalAlignment="Right" Margin="0,10,0,0"
                                Click="OnOpenClick" AutomationProperties.AutomationId="CodexOpen">
                            <ui:IconView Icon="{x:Static ui:Icons.OpenApp}" Width="13" Height="13" Foreground="{DynamicResource Theme.Text}" />
                        </Button>
                    </StackPanel>

                    <!-- Cursor monthly plan usage (one window, so no tabs). -->
                    <StackPanel x:Name="CursorCard" Visibility="Collapsed">
                        <DockPanel>
                            <Button x:Name="CursorInfo" DockPanel.Dock="Right" Style="{StaticResource CardInfoButton}" Margin="6,0,0,0"
                                    Click="OnInfoClick" AutomationProperties.AutomationId="CursorInfo" />
                            <StackPanel Orientation="Horizontal">
                                <ui:IconView Icon="{x:Static ui:Icons.Cursor}" Style="{StaticResource CardIcon}" />
                                <TextBlock Text="{DynamicResource Card.Cursor}" Style="{StaticResource CardTitle}" Margin="9,0,0,0" />
                                <Border x:Name="CursorPlan" Style="{StaticResource PlanBadge}">
                                    <TextBlock x:Name="CursorPlanText" Style="{StaticResource PlanBadgeText}" />
                                </Border>
                                <!-- With more than one account (Ajustes › Agentes): one tag per account instead of the
                                     plan badge; a click switches account (EdgeWindow.SetAccounts). -->
                                <StackPanel x:Name="CursorAccountBadges" Orientation="Horizontal" Margin="2,0,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </DockPanel>
                        <!-- More than MaxTagsBesideTitle accounts: their tags go here, under the title, wrapping. -->
                        <WrapPanel x:Name="CursorAccountRow" Margin="-4,6,0,0" Visibility="Collapsed" />
                        <StackPanel x:Name="CursorMetrics" Margin="0,11,0,0">
                            <DockPanel>
                                <TextBlock x:Name="CursorHeaderReset" DockPanel.Dock="Right" Style="{StaticResource SecondaryText}" Margin="10,0,0,0" />
                                <TextBlock Text="{DynamicResource Row.MonthlyCycle}" Style="{StaticResource RowLabel}" />
                            </DockPanel>
                            <ui:LinearBar x:Name="CursorCycleBar" Height="4" Margin="0,6,0,0" />
                            <TextBlock x:Name="CursorCycleValue" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                            <!-- On-demand spend (paid beyond the plan), only when enabled and used; the bar needs a limit. -->
                            <StackPanel x:Name="CursorOnDemandRow" Visibility="Collapsed">
                                <TextBlock Text="{DynamicResource Row.OnDemand}" Style="{StaticResource RowLabel}" Margin="0,11,0,0" />
                                <ui:LinearBar x:Name="CursorOnDemandBar" Height="4" Margin="0,6,0,0" />
                                <TextBlock x:Name="CursorOnDemandValue" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                            </StackPanel>
                            <!-- Orb's reading, shown because OCE has none of its own (App.WithOrbUsage). -->
                            <TextBlock x:Name="CursorSource" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,9,0,0" Visibility="Collapsed" />
                        </StackPanel>
                        <TextBlock x:Name="CursorMessage" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,11,0,0" Visibility="Collapsed" />
                        <!-- "Abrir Cursor": its app, or its web page (AppLauncher). -->
                        <Button x:Name="CursorOpen" Style="{StaticResource CardRoundButton}" HorizontalAlignment="Right" Margin="0,10,0,0"
                                Click="OnOpenClick" AutomationProperties.AutomationId="CursorOpen">
                            <ui:IconView Icon="{x:Static ui:Icons.OpenApp}" Width="13" Height="13" Foreground="{DynamicResource Theme.Text}" />
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="OpenCodeCard" Visibility="Collapsed">
                        <DockPanel>
                            <Button x:Name="OpenCodeInfo" DockPanel.Dock="Right" Style="{StaticResource CardInfoButton}" Margin="6,0,0,0" Visibility="Collapsed"
                                    Click="OnInfoClick" AutomationProperties.AutomationId="OpenCodeInfo" />
                            <StackPanel Orientation="Horizontal">
                                <ui:IconView Icon="{x:Static ui:Icons.OpenCode}" Style="{StaticResource CardIcon}" />
                                <TextBlock Text="{DynamicResource Card.OpenCode}" Style="{StaticResource CardTitle}" Margin="9,0,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <StackPanel x:Name="OpenCodeMetrics" Margin="0,11,0,0">
                            <TextBlock Text="{DynamicResource Row.InputTokens}" Style="{StaticResource RowLabel}" />
                            <TextBlock x:Name="OpenCodeInput" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                            <TextBlock Text="{DynamicResource Row.OutputTokens}" Style="{StaticResource RowLabel}" Margin="0,11,0,0" />
                            <TextBlock x:Name="OpenCodeOutput" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                            <TextBlock Text="{DynamicResource Row.ReasoningTokens}" Style="{StaticResource RowLabel}" Margin="0,11,0,0" />
                            <TextBlock x:Name="OpenCodeReasoning" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                            <TextBlock Text="{DynamicResource Row.Cache}" Style="{StaticResource RowLabel}" Margin="0,11,0,0" />
                            <TextBlock x:Name="OpenCodeCache" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                            <TextBlock Text="{DynamicResource Row.TotalCost}" Style="{StaticResource RowLabel}" Margin="0,11,0,0" />
                            <TextBlock x:Name="OpenCodeCost" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="OpenCodeMessage" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,11,0,0" Visibility="Collapsed" />
                        <!-- "Abrir OpenCode": its app, or its web page (AppLauncher). -->
                        <Button x:Name="OpenCodeOpen" Style="{StaticResource CardRoundButton}" HorizontalAlignment="Right" Margin="0,10,0,0"
                                Click="OnOpenClick" AutomationProperties.AutomationId="OpenCodeOpen">
                            <ui:IconView Icon="{x:Static ui:Icons.OpenApp}" Width="13" Height="13" Foreground="{DynamicResource Theme.Text}" />
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="DeepSeekCard" Visibility="Collapsed">
                        <DockPanel>
                            <Button x:Name="DeepSeekInfo" DockPanel.Dock="Right" Style="{StaticResource CardInfoButton}" Margin="6,0,0,0" Visibility="Collapsed"
                                    Click="OnInfoClick" AutomationProperties.AutomationId="DeepSeekInfo" />
                            <StackPanel Orientation="Horizontal">
                                <ui:IconView Icon="{x:Static ui:Icons.DeepSeek}" Style="{StaticResource CardIcon}" />
                                <TextBlock Text="{DynamicResource Card.DeepSeek}" Style="{StaticResource CardTitle}" Margin="9,0,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <StackPanel x:Name="DeepSeekMetrics" Margin="0,11,0,0">
                            <TextBlock Text="{DynamicResource Row.Balance}" Style="{StaticResource RowLabel}" />
                            <TextBlock x:Name="DeepSeekBalance" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="DeepSeekMessage" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,11,0,0" Visibility="Collapsed" />
                        <!-- "Abrir DeepSeek": its app, or its web page (AppLauncher). -->
                        <Button x:Name="DeepSeekOpen" Style="{StaticResource CardRoundButton}" HorizontalAlignment="Right" Margin="0,10,0,0"
                                Click="OnOpenClick" AutomationProperties.AutomationId="DeepSeekOpen">
                            <ui:IconView Icon="{x:Static ui:Icons.OpenApp}" Width="13" Height="13" Foreground="{DynamicResource Theme.Text}" />
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="OpenRouterCard" Visibility="Collapsed">
                        <DockPanel>
                            <Button x:Name="OpenRouterInfo" DockPanel.Dock="Right" Style="{StaticResource CardInfoButton}" Margin="6,0,0,0" Visibility="Collapsed"
                                    Click="OnInfoClick" AutomationProperties.AutomationId="OpenRouterInfo" />
                            <StackPanel Orientation="Horizontal">
                                <ui:IconView Icon="{x:Static ui:Icons.OpenRouter}" Style="{StaticResource CardIcon}" />
                                <TextBlock Text="{DynamicResource Card.OpenRouter}" Style="{StaticResource CardTitle}" Margin="9,0,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <StackPanel x:Name="OpenRouterMetrics" Margin="0,11,0,0">
                            <TextBlock x:Name="OpenRouterMetricLabel" Text="{DynamicResource Row.Spend}" Style="{StaticResource RowLabel}" />
                            <TextBlock x:Name="OpenRouterUsage" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                            <TextBlock x:Name="OpenRouterRemainingLabel" Text="{DynamicResource Row.LimitRemaining}" Style="{StaticResource RowLabel}" Margin="0,11,0,0" Visibility="Collapsed" />
                            <TextBlock x:Name="OpenRouterRemaining" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" Visibility="Collapsed" />
                        </StackPanel>
                        <TextBlock x:Name="OpenRouterMessage" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,11,0,0" Visibility="Collapsed" />
                        <!-- "Abrir OpenRouter": its app, or its web page (AppLauncher). -->
                        <Button x:Name="OpenRouterOpen" Style="{StaticResource CardRoundButton}" HorizontalAlignment="Right" Margin="0,10,0,0"
                                Click="OnOpenClick" AutomationProperties.AutomationId="OpenRouterOpen">
                            <ui:IconView Icon="{x:Static ui:Icons.OpenApp}" Width="13" Height="13" Foreground="{DynamicResource Theme.Text}" />
                        </Button>
                    </StackPanel>

                    <!-- CPU -->
                    <StackPanel x:Name="CpuCard" Visibility="Collapsed">
                        <DockPanel>
                            <TextBlock x:Name="CpuSince" DockPanel.Dock="Right" Style="{StaticResource SecondaryText}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                            <StackPanel Orientation="Horizontal">
                                <ui:IconView Icon="{x:Static ui:Icons.Cpu}" Style="{StaticResource CardIcon}" />
                                <TextBlock x:Name="CpuTitle" Text="CPU" Style="{StaticResource CardTitle}" Margin="9,0,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <StackPanel Margin="0,11,0,0">
                            <TextBlock Text="{DynamicResource Row.Temperature}" Style="{StaticResource RowLabel}" />
                            <ui:LinearBar x:Name="TempBar" Height="4" Margin="0,6,0,0" />
                            <TextBlock x:Name="TempValue" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />

                            <TextBlock Text="{DynamicResource Row.SessionMax}" Style="{StaticResource RowLabel}" Margin="0,11,0,0" />
                            <ui:LinearBar x:Name="MaxBar" Height="4" Margin="0,6,0,0" />
                            <TextBlock x:Name="MaxValue" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />

                            <TextBlock Text="{DynamicResource Row.CpuLoad}" Style="{StaticResource RowLabel}" Margin="0,11,0,0" />
                            <ui:LinearBar x:Name="LoadBar" Height="4" Margin="0,6,0,0" />
                            <TextBlock x:Name="LoadValue" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                        </StackPanel>

                        <TextBlock x:Name="CpuMessage" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                   Margin="0,14,0,0" Visibility="Collapsed" />
                    </StackPanel>

                    <!-- GPU (NVIDIA, AMD or Intel) -->
                    <StackPanel x:Name="GpuCard" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <ui:IconView Icon="{x:Static ui:Icons.Gpu}" Style="{StaticResource CardIcon}" />
                            <TextBlock x:Name="GpuTitle" Text="GPU" Style="{StaticResource CardTitle}" Margin="9,0,0,0" />
                        </StackPanel>

                        <StackPanel Margin="0,11,0,0">
                            <TextBlock Text="{DynamicResource Row.Temperature}" Style="{StaticResource RowLabel}" />
                            <ui:LinearBar x:Name="GpuTempBar" Height="4" Margin="0,6,0,0" />
                            <TextBlock x:Name="GpuTempValue" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />

                            <TextBlock Text="{DynamicResource Row.GpuLoad}" Style="{StaticResource RowLabel}" Margin="0,11,0,0" />
                            <ui:LinearBar x:Name="GpuLoadBar" Height="4" Margin="0,6,0,0" />
                            <TextBlock x:Name="GpuLoadValue" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />

                            <!-- Only when the GPU exposes "GPU Memory Used"; the bar needs "GPU Memory Total" too. -->
                            <StackPanel x:Name="GpuMemoryRow" Visibility="Collapsed">
                                <TextBlock Text="{DynamicResource Row.MemoryUsed}" Style="{StaticResource RowLabel}" Margin="0,11,0,0" />
                                <ui:LinearBar x:Name="GpuMemoryBar" Height="4" Margin="0,6,0,0" />
                                <TextBlock x:Name="GpuMemoryValue" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock x:Name="GpuMessage" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                   Margin="0,14,0,0" Visibility="Collapsed" />
                    </StackPanel>

                    <!-- RAM: physical memory in use, cache and committed memory. -->
                    <StackPanel x:Name="RamCard" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <ui:IconView Icon="{x:Static ui:Icons.Ram}" Style="{StaticResource CardIcon}" />
                            <TextBlock Text="{DynamicResource Card.Ram}" Style="{StaticResource CardTitle}" Margin="9,0,0,0" />
                        </StackPanel>

                        <StackPanel x:Name="RamMetrics" Margin="0,11,0,0">
                            <TextBlock Text="{DynamicResource Row.RamInUse}" Style="{StaticResource RowLabel}" />
                            <ui:LinearBar x:Name="RamBar" Height="4" Margin="0,6,0,0" />
                            <TextBlock x:Name="RamUsedValue" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />

                            <DockPanel Margin="0,11,0,0">
                                <TextBlock x:Name="RamCachedValue" DockPanel.Dock="Right" Text="--" Style="{StaticResource ValueText}" />
                                <TextBlock Text="{DynamicResource Row.RamCached}" Style="{StaticResource RowLabel}" />
                            </DockPanel>
                            <DockPanel Margin="0,7,0,0">
                                <TextBlock x:Name="RamCommittedValue" DockPanel.Dock="Right" Text="--" Style="{StaticResource ValueText}" />
                                <TextBlock Text="{DynamicResource Row.RamCommitted}" Style="{StaticResource RowLabel}" />
                            </DockPanel>
                        </StackPanel>

                        <TextBlock x:Name="RamMessage" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                   Margin="0,11,0,0" Visibility="Collapsed" />
                        <!-- The "Liberar RAM" hint, then its outcome ("Liberados 812 MB"). -->
                        <TextBlock x:Name="RamNote" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,11,0,0" />
                    </StackPanel>

                    <!-- FPS of the program in the foreground (FpsService), or of the desktop. -->
                    <StackPanel x:Name="FpsCard" Visibility="Collapsed">
                        <DockPanel>
                            <TextBlock x:Name="FpsRefresh" DockPanel.Dock="Right" Style="{StaticResource SecondaryText}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                            <StackPanel Orientation="Horizontal">
                                <ui:IconView Icon="{x:Static ui:Icons.Fps}" Style="{StaticResource CardIcon}" />
                                <TextBlock Text="{DynamicResource Card.Fps}" Style="{StaticResource CardTitle}" Margin="9,0,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <StackPanel x:Name="FpsMetrics" Margin="0,11,0,0">
                            <DockPanel>
                                <TextBlock x:Name="FpsSource" DockPanel.Dock="Right" Style="{StaticResource SecondaryText}" Margin="10,0,0,0"
                                           TextTrimming="CharacterEllipsis" MaxWidth="130" />
                                <TextBlock Text="{DynamicResource Row.FramesPerSecond}" Style="{StaticResource RowLabel}" />
                            </DockPanel>
                            <ui:LinearBar x:Name="FpsBar" Height="4" Margin="0,6,0,0" />
                            <TextBlock x:Name="FpsValue" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                            <DockPanel Margin="0,11,0,0">
                                <TextBlock x:Name="FpsFrameTime" DockPanel.Dock="Right" Text="--" Style="{StaticResource ValueText}" />
                                <TextBlock Text="{DynamicResource Row.FrameTime}" Style="{StaticResource RowLabel}" />
                            </DockPanel>
                        </StackPanel>
                        <TextBlock x:Name="FpsMessage" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,11,0,0" Visibility="Collapsed" />
                    </StackPanel>

                    <!-- Modo juego: what it does or did, and how to switch it (GameModeService). -->
                    <StackPanel x:Name="GameModeCard" Visibility="Collapsed">
                        <DockPanel>
                            <TextBlock x:Name="GameModeState" DockPanel.Dock="Right" Style="{StaticResource SecondaryText}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                            <StackPanel Orientation="Horizontal">
                                <ui:IconView Icon="{x:Static ui:Icons.Gamepad}" Style="{StaticResource CardIcon}" />
                                <TextBlock Text="{DynamicResource Card.GameMode}" Style="{StaticResource CardTitle}" Margin="9,0,0,0" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock x:Name="GameModeSummary" Style="{StaticResource ValueText}" TextWrapping="Wrap" Margin="0,11,0,0" />
                        <TextBlock x:Name="GameModeErrors" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,9,0,0" Visibility="Collapsed" />
                        <TextBlock x:Name="GameModeHint" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,11,0,0" />
                    </StackPanel>

                    <!-- The bubble of a card's (i): the subscription of the account shown. Over the card's content, its tail
                         under the (i); closed by the (i) again, a click on the card or another ring. -->
                    <Grid x:Name="InfoBubble" Panel.ZIndex="10" VerticalAlignment="Top" HorizontalAlignment="Right"
                          Margin="0,24,-8,0" MaxWidth="242" Visibility="Collapsed">
                        <Border Margin="0,7,0,0" Background="{DynamicResource Theme.Menu}" BorderBrush="{DynamicResource Theme.Border}"
                                BorderThickness="1" CornerRadius="12" Padding="12,9,12,10">
                            <StackPanel>
                                <TextBlock x:Name="InfoTitle" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Theme.Text}" />
                                <TextBlock x:Name="InfoText" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="15"
                                           Foreground="{DynamicResource Theme.TextSecondary}" />
                            </StackPanel>
                        </Border>
                        <Path HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,9,0" Data="M 0,8.6 L 7,1.6 L 14,8.6"
                              Fill="{DynamicResource Theme.Menu}" Stroke="{DynamicResource Theme.Border}" StrokeThickness="1" />
                    </Grid>

                </Grid>
            </Border>
        </Grid>

        <!-- Panel: a tab whose concave flares (38 above and below the body) melt into the screen edge. -->
        <Grid x:Name="EdgePanel" Width="94">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="PanelShift" X="94" />
            </Grid.RenderTransform>

            <ui:EdgeTabShape x:Name="PanelShape" Fill="{DynamicResource Theme.Background}" CornerRadius="32" FlareHeight="38" />

            <Grid x:Name="PanelRoot" Margin="0,38,0,38">
                <StackPanel x:Name="PanelStack" Margin="0,20,0,14">
                    <!-- The rings of the active view, in its order (EdgeWindow.ApplyViews); faded out and in when the view
                         changes. -->
                    <StackPanel x:Name="RingStack">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="RingShift" />
                        </StackPanel.RenderTransform>
                        <!-- Un clic renueva la sesión de Claude sin abrir ventanas (ver App.RenewClaudeSessionAsync). -->
                        <Grid x:Name="ClaudeItem" Background="Transparent" Cursor="Hand"
                              ToolTip="{DynamicResource Tip.ClaudeRing}"
                              MouseLeftButtonUp="OnClaudeClick">
                            <StackPanel>
                                <ui:RingGauge x:Name="ClaudeRing" Style="{StaticResource PanelRing}" Icon="{x:Static ui:Icons.ClaudeSpark}">
                                    <ui:RingGauge.RenderTransform>
                                        <ScaleTransform />
                                    </ui:RingGauge.RenderTransform>
                                </ui:RingGauge>
                                <TextBlock x:Name="ClaudeLabel" Text="--" Style="{StaticResource RingLabel}" />
                            </StackPanel>
                        </Grid>

                        <!-- Hidden when Codex/ChatGPT is not installed (see AiDetector). -->
                        <Grid x:Name="CodexItem" Background="Transparent" Margin="0,10,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <ui:RingGauge x:Name="CodexRing" Style="{StaticResource PanelRing}" Icon="{x:Static ui:Icons.Codex}">
                                    <ui:RingGauge.RenderTransform>
                                        <ScaleTransform />
                                    </ui:RingGauge.RenderTransform>
                                </ui:RingGauge>
                                <TextBlock x:Name="CodexLabel" Text="--" Style="{StaticResource RingLabel}" />
                            </StackPanel>
                        </Grid>

                        <!-- Hidden when Cursor is not installed (see AiDetector). -->
                        <Grid x:Name="CursorItem" Background="Transparent" Margin="0,10,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <ui:RingGauge x:Name="CursorRing" Style="{StaticResource PanelRing}" Icon="{x:Static ui:Icons.Cursor}">
                                    <ui:RingGauge.RenderTransform><ScaleTransform /></ui:RingGauge.RenderTransform>
                                </ui:RingGauge>
                                <TextBlock x:Name="CursorLabel" Text="--" Style="{StaticResource RingLabel}" />
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="OpenCodeItem" Background="Transparent" Margin="0,10,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <ui:RingGauge x:Name="OpenCodeRing" Style="{StaticResource PanelRing}" Icon="{x:Static ui:Icons.OpenCode}">
                                    <ui:RingGauge.RenderTransform><ScaleTransform /></ui:RingGauge.RenderTransform>
                                </ui:RingGauge>
                                <TextBlock x:Name="OpenCodeLabel" Text="--" Style="{StaticResource RingLabel}" />
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="DeepSeekItem" Background="Transparent" Margin="0,10,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <ui:RingGauge x:Name="DeepSeekRing" Style="{StaticResource PanelRing}" Icon="{x:Static ui:Icons.DeepSeek}">
                                    <ui:RingGauge.RenderTransform><ScaleTransform /></ui:RingGauge.RenderTransform>
                                </ui:RingGauge>
                                <TextBlock x:Name="DeepSeekLabel" Text="--" Style="{StaticResource RingLabel}" />
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="OpenRouterItem" Background="Transparent" Margin="0,10,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <ui:RingGauge x:Name="OpenRouterRing" Style="{StaticResource PanelRing}" Icon="{x:Static ui:Icons.OpenRouter}">
                                    <ui:RingGauge.RenderTransform><ScaleTransform /></ui:RingGauge.RenderTransform>
                                </ui:RingGauge>
                                <TextBlock x:Name="OpenRouterLabel" Text="--" Style="{StaticResource RingLabel}" />
                            </StackPanel>
                        </Grid>
                        <!-- Un clic abre Configuración > Sistema > Información, sin privilegios de administrador. -->
                        <Grid x:Name="CpuItem" Background="Transparent" Margin="0,10,0,0" Cursor="Hand"
                              ToolTip="{DynamicResource Tip.CpuRing}" MouseLeftButtonUp="OnCpuClick">
                            <StackPanel>
                                <ui:RingGauge x:Name="CpuRing" Style="{StaticResource PanelRing}" Icon="{x:Static ui:Icons.Cpu}">
                                    <ui:RingGauge.RenderTransform>
                                        <ScaleTransform />
                                    </ui:RingGauge.RenderTransform>
                                </ui:RingGauge>
                                <TextBlock x:Name="CpuLabel" Text="--" Style="{StaticResource RingLabel}" />
                            </StackPanel>
                        </Grid>

                        <!-- Hidden until a GPU is detected (see HardwareSensorService). -->
                        <Grid x:Name="GpuItem" Background="Transparent" Margin="0,10,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <ui:RingGauge x:Name="GpuRing" Style="{StaticResource PanelRing}" Icon="{x:Static ui:Icons.Gpu}">
                                    <ui:RingGauge.RenderTransform>
                                        <ScaleTransform />
                                    </ui:RingGauge.RenderTransform>
                                </ui:RingGauge>
                                <TextBlock x:Name="GpuLabel" Text="--" Style="{StaticResource RingLabel}" />
                            </StackPanel>
                        </Grid>

                        <!-- Physical memory in use; a click frees RAM (App.FreeRamAsync). -->
                        <Grid x:Name="RamItem" Background="Transparent" Margin="0,10,0,0" Cursor="Hand"
                              ToolTip="{DynamicResource Tip.RamRing}" MouseLeftButtonUp="OnRamClick">
                            <StackPanel>
                                <ui:RingGauge x:Name="RamRing" Style="{StaticResource PanelRing}" Icon="{x:Static ui:Icons.Ram}">
                                    <ui:RingGauge.RenderTransform><ScaleTransform /></ui:RingGauge.RenderTransform>
                                </ui:RingGauge>
                                <TextBlock x:Name="RamLabel" Text="--" Style="{StaticResource RingLabel}" />
                            </StackPanel>
                        </Grid>

                        <!-- FPS of the program in the foreground; first ring of the PC view. -->
                        <Grid x:Name="FpsItem" Background="Transparent" Margin="0,10,0,0">
                            <StackPanel>
                                <ui:RingGauge x:Name="FpsRing" Style="{StaticResource PanelRing}" Icon="{x:Static ui:Icons.Fps}">
                                    <ui:RingGauge.RenderTransform><ScaleTransform /></ui:RingGauge.RenderTransform>
                                </ui:RingGauge>
                                <TextBlock x:Name="FpsLabel" Text="--" Style="{StaticResource RingLabel}" />
                            </StackPanel>
                        </Grid>

                        <!-- Modo juego: a ring that works as a switch (empty off, full on). -->
                        <Grid x:Name="GameModeItem" Background="Transparent" Margin="0,10,0,0" Cursor="Hand"
                              ToolTip="{DynamicResource Tip.GameModeOn}" MouseLeftButtonUp="OnGameModeClick">
                            <StackPanel>
                                <ui:RingGauge x:Name="GameModeRing" Style="{StaticResource PanelRing}" Icon="{x:Static ui:Icons.Gamepad}">
                                    <ui:RingGauge.RenderTransform><ScaleTransform /></ui:RingGauge.RenderTransform>
                                </ui:RingGauge>
                                <TextBlock x:Name="GameModeLabel" Text="--" Style="{StaticResource RingLabel}" FontSize="13" Margin="0,9,0,2" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Round buttons, two by two: pin and view above, settings and close below (EdgeWindow.LayOutButtons). -->
                    <StackPanel x:Name="PanelButtons" Margin="0,14,0,0" HorizontalAlignment="Center">
                        <StackPanel x:Name="ButtonRowTop" Orientation="Horizontal" HorizontalAlignment="Center">
                            <!-- Fijar: a pin, filled while the panel is pinned (EdgeWindow.SyncModeButton). -->
                            <Button x:Name="ModeButton" Style="{StaticResource PanelRoundButton}" Click="OnModeClick"
                                    AutomationProperties.AutomationId="ModeButton">
                                <ui:IconView x:Name="ModeIcon" Icon="{x:Static ui:Icons.Pin}" Foreground="{DynamicResource Theme.Text}" />
                            </Button>
                            <!-- Next view: IA → PC → Personalizada (when it is switched on). -->
                            <Button x:Name="ViewButton" Style="{StaticResource PanelRoundButton}" Click="OnViewClick"
                                    ToolTip="{DynamicResource Tip.View}" AutomationProperties.AutomationId="ViewButton"
                                    AutomationProperties.Name="{DynamicResource Tip.View}">
                                <ui:IconView Icon="{x:Static ui:Icons.SwitchView}" Foreground="{DynamicResource Theme.Text}" />
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="ButtonRowBottom" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="SettingsButton" Style="{StaticResource PanelRoundButton}" Click="OnSettingsClick"
                                    ToolTip="{DynamicResource Tip.Settings}" AutomationProperties.AutomationId="SettingsButton"
                                    AutomationProperties.Name="{DynamicResource Tip.Settings}">
                                <!-- The dot: a new version is available (Settings shows how to install it). -->
                                <Grid>
                                    <ui:IconView x:Name="SettingsIcon" Icon="{x:Static ui:Icons.Gear}" Foreground="{DynamicResource Theme.Text}" />
                                    <Ellipse x:Name="UpdateDot" Width="7" Height="7" Fill="#FF3B30" HorizontalAlignment="Right"
                                             VerticalAlignment="Top" Margin="0,-3,-3,0" Visibility="Collapsed" />
                                </Grid>
                            </Button>
                            <!-- Quits the whole application, like "Salir" in the tray menu. Held down (or while editing
                                 the widget from Ajustes) it is the handle that drags the panel along the screen edges
                                 instead (EdgeWindow.OnHandleDown). -->
                            <Button x:Name="CloseButton" Style="{StaticResource PanelRoundButton}" Click="OnCloseClick"
                                    RenderTransformOrigin="0.5,0.5"
                                    PreviewMouseLeftButtonDown="OnHandleDown" PreviewMouseMove="OnHandleMove"
                                    PreviewMouseLeftButtonUp="OnHandleUp" LostMouseCapture="OnHandleLost"
                                    ToolTip="{DynamicResource Tip.Close}" AutomationProperties.AutomationId="CloseButton"
                                    AutomationProperties.Name="{DynamicResource Tip.Close}">
                                <Button.RenderTransform>
                                    <ScaleTransform x:Name="CloseScale" />
                                </Button.RenderTransform>
                                <!-- The ring fills while ✕ is held, stays full while it is the handle and drains over the
                                     3 s before ✕ comes back (EdgeWindow.FillHoldRing / DrainHoldRing). -->
                                <Grid>
                                    <Ellipse x:Name="HoldRing" Margin="-7" StrokeThickness="2.5" Opacity="0" IsHitTestVisible="False"
                                             Stroke="{DynamicResource Theme.Text}" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="-90" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <ui:IconView x:Name="CloseIcon" Icon="{x:Static ui:Icons.Close}" Foreground="{DynamicResource Theme.Text}" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

            </Grid>
        </Grid>

        <!-- Editing the widget (Ajustes › Personalización › Editar widget): a grip just past the panel's end; dragged
             along the edge it makes the panel bigger or smaller (EdgeWindow.OnGripDown). -->
        <Button x:Name="ResizeGrip" Style="{StaticResource PanelRoundButton}" Tag="on" Visibility="Collapsed" Opacity="0"
                PreviewMouseLeftButtonDown="OnGripDown" PreviewMouseMove="OnGripMove"
                PreviewMouseLeftButtonUp="OnGripUp" LostMouseCapture="OnGripLost"
                ToolTip="{DynamicResource Tip.Resize}" AutomationProperties.AutomationId="ResizeGrip"
                AutomationProperties.Name="{DynamicResource Tip.Resize}">
            <ui:IconView x:Name="GripIcon" Icon="{x:Static ui:Icons.Resize}" Foreground="{DynamicResource Theme.Background}" />
        </Button>

        <!-- Editing the widget: the panel's size, next to the grip, live while it is dragged (EdgeWindow.SyncSizeBadge). -->
        <Border x:Name="SizeBadge" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" CornerRadius="11" Padding="9,3,9,4"
                Background="{DynamicResource Theme.Background}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1">
            <TextBlock x:Name="SizeText" FontSize="12" Foreground="{DynamicResource Theme.Text}" />
        </Border>

    </Canvas>
    </Grid>
</Window>
