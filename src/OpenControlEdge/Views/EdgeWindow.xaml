<Window x:Class="OpenControlEdge.Views.EdgeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:OpenControlEdge.Ui"
        Title="Open Control Edge"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        Focusable="False"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}"
        Foreground="White"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale">

    <!-- All sizes are the original design scaled to 85 % (rings 64 → 54, panel 110 → 94, card 300 → 255 …). -->
    <Canvas x:Name="Root" ClipToBounds="True">

        <!-- Auto mode, collapsed: 5 px strip on the right edge (hover target, deliberately not scaled). -->
        <Rectangle x:Name="Strip" Width="5" Height="400" Fill="#99808080" />

        <!-- Detail card (to the left of the panel). -->
        <Grid x:Name="Card" Opacity="0" IsHitTestVisible="False">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="CardShift" />
            </Grid.RenderTransform>

            <!-- No DropShadowEffect: the beak moves on every ring switch and the effect would re-rasterise each frame. -->
            <ui:CardShape x:Name="CardBackground" Fill="#000000" CornerRadius="20" BeakLength="16" BeakHalfHeight="15" />

            <Border x:Name="ContentClip" ClipToBounds="True" Margin="0,0,16,0">
                <Grid x:Name="CardContent" Margin="16,15,16,15" VerticalAlignment="Top">

                    <!-- Claude -->
                    <StackPanel x:Name="ClaudeCard">
                        <!-- Header: icon, title and plan badge. Resets sit on each metric row, leaving room for the badge. -->
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{x:Static ui:Icons.ClaudeSparkImage}" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="Uso de Claude" Style="{StaticResource CardTitle}" Margin="9,0,0,0" />
                            <Border x:Name="ClaudePlan" Style="{StaticResource PlanBadge}">
                                <TextBlock x:Name="ClaudePlanText" Style="{StaticResource PlanBadgeText}" />
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="ClaudeMetrics" Margin="0,11,0,0">
                            <DockPanel>
                                <TextBlock x:Name="ClaudeHeaderReset" DockPanel.Dock="Right" Style="{StaticResource SecondaryText}" Margin="10,0,0,0" />
                                <TextBlock Text="Sesión actual" Style="{StaticResource RowLabel}" />
                            </DockPanel>
                            <ui:LinearBar x:Name="SessionBar" Height="4" Margin="0,6,0,0" />
                            <TextBlock x:Name="SessionValue" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />

                            <DockPanel Margin="0,11,0,0">
                                <TextBlock x:Name="WeeklyReset" DockPanel.Dock="Right" Style="{StaticResource SecondaryText}" Margin="10,0,0,0" />
                                <TextBlock Text="Semanal" Style="{StaticResource RowLabel}" />
                            </DockPanel>
                            <ui:LinearBar x:Name="WeeklyBar" Height="4" Margin="0,6,0,0" />
                            <TextBlock x:Name="WeeklyValue" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />

                            <!-- Usage credits spent (spend.used). The endpoint carries no remaining balance. -->
                            <DockPanel x:Name="ClaudeSpendRow" Margin="0,11,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="ClaudeSpendValue" DockPanel.Dock="Right" Style="{StaticResource ValueText}" VerticalAlignment="Center" />
                                <TextBlock Text="Gastado" Style="{StaticResource RowLabel}" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>

                        <TextBlock x:Name="ClaudeMessage" Style="{StaticResource ValueText}" TextWrapping="Wrap"
                                   Margin="0,11,0,0" Visibility="Collapsed" />
                    </StackPanel>

                    <!-- Codex: one row per window the API returns, labelled by its length. -->
                    <StackPanel x:Name="CodexCard" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{x:Static ui:Icons.CodexImage}" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="Uso de Codex" Style="{StaticResource CardTitle}" Margin="9,0,0,0" />
                            <Border x:Name="CodexPlan" Style="{StaticResource PlanBadge}">
                                <TextBlock x:Name="CodexPlanText" Style="{StaticResource PlanBadgeText}" />
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="CodexMetrics" Margin="0,11,0,0">
                            <DockPanel>
                                <TextBlock x:Name="CodexHeaderReset" DockPanel.Dock="Right" Style="{StaticResource SecondaryText}" Margin="10,0,0,0" />
                                <TextBlock x:Name="CodexPrimaryLabel" Style="{StaticResource RowLabel}" />
                            </DockPanel>
                            <ui:LinearBar x:Name="CodexPrimaryBar" Height="4" Margin="0,6,0,0" />
                            <TextBlock x:Name="CodexPrimaryValue" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />

                            <StackPanel x:Name="CodexSecondaryRow" Visibility="Collapsed">
                                <DockPanel Margin="0,11,0,0">
                                    <TextBlock x:Name="CodexSecondaryReset" DockPanel.Dock="Right" Style="{StaticResource SecondaryText}" Margin="10,0,0,0" />
                                    <TextBlock x:Name="CodexSecondaryLabel" Style="{StaticResource RowLabel}" />
                                </DockPanel>
                                <ui:LinearBar x:Name="CodexSecondaryBar" Height="4" Margin="0,6,0,0" />
                                <TextBlock x:Name="CodexSecondaryValue" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock x:Name="CodexMessage" Style="{StaticResource ValueText}" TextWrapping="Wrap"
                                   Margin="0,11,0,0" Visibility="Collapsed" />
                    </StackPanel>

                    <!-- Cursor monthly plan usage. -->
                    <StackPanel x:Name="CursorCard" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{x:Static ui:Icons.CursorImage}" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="Uso de Cursor" Style="{StaticResource CardTitle}" Margin="9,0,0,0" />
                            <Border x:Name="CursorPlan" Style="{StaticResource PlanBadge}">
                                <TextBlock x:Name="CursorPlanText" Style="{StaticResource PlanBadgeText}" />
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="CursorMetrics" Margin="0,11,0,0">
                            <DockPanel>
                                <TextBlock x:Name="CursorHeaderReset" DockPanel.Dock="Right" Style="{StaticResource SecondaryText}" Margin="10,0,0,0" />
                                <TextBlock Text="Ciclo mensual" Style="{StaticResource RowLabel}" />
                            </DockPanel>
                            <ui:LinearBar x:Name="CursorCycleBar" Height="4" Margin="0,6,0,0" />
                            <TextBlock x:Name="CursorCycleValue" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                            <StackPanel x:Name="CursorOnDemandRow" Visibility="Collapsed">
                                <TextBlock Text="Bajo demanda" Style="{StaticResource RowLabel}" Margin="0,11,0,0" />
                                <ui:LinearBar x:Name="CursorOnDemandBar" Height="4" Margin="0,6,0,0" />
                                <TextBlock x:Name="CursorOnDemandValue" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="CursorMessage" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,11,0,0" Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel x:Name="OpenCodeCard" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{x:Static ui:Icons.OpenCodeImage}" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="Uso de OpenCode" Style="{StaticResource CardTitle}" Margin="9,0,0,0" />
                        </StackPanel>
                        <StackPanel x:Name="OpenCodeMetrics" Margin="0,11,0,0">
                            <TextBlock Text="Tokens de entrada" Style="{StaticResource RowLabel}" />
                            <TextBlock x:Name="OpenCodeInput" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                            <TextBlock Text="Tokens de salida" Style="{StaticResource RowLabel}" Margin="0,11,0,0" />
                            <TextBlock x:Name="OpenCodeOutput" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                            <TextBlock Text="Tokens de razonamiento" Style="{StaticResource RowLabel}" Margin="0,11,0,0" />
                            <TextBlock x:Name="OpenCodeReasoning" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                            <TextBlock Text="Caché (lectura / escritura)" Style="{StaticResource RowLabel}" Margin="0,11,0,0" />
                            <TextBlock x:Name="OpenCodeCache" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                            <TextBlock Text="Coste acumulado" Style="{StaticResource RowLabel}" Margin="0,11,0,0" />
                            <TextBlock x:Name="OpenCodeCost" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="OpenCodeMessage" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,11,0,0" Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel x:Name="DeepSeekCard" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{x:Static ui:Icons.DeepSeekImage}" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="Uso de DeepSeek" Style="{StaticResource CardTitle}" Margin="9,0,0,0" />
                        </StackPanel>
                        <StackPanel x:Name="DeepSeekMetrics" Margin="0,11,0,0">
                            <TextBlock Text="Saldo restante" Style="{StaticResource RowLabel}" />
                            <TextBlock x:Name="DeepSeekBalance" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="DeepSeekMessage" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,11,0,0" Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel x:Name="OpenRouterCard" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{x:Static ui:Icons.OpenRouterImage}" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="Uso de OpenRouter" Style="{StaticResource CardTitle}" Margin="9,0,0,0" />
                        </StackPanel>
                        <StackPanel x:Name="OpenRouterMetrics" Margin="0,11,0,0">
                            <TextBlock x:Name="OpenRouterMetricLabel" Text="Gasto" Style="{StaticResource RowLabel}" />
                            <TextBlock x:Name="OpenRouterUsage" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                            <TextBlock x:Name="OpenRouterRemainingLabel" Text="Límite restante" Style="{StaticResource RowLabel}" Margin="0,11,0,0" Visibility="Collapsed" />
                            <TextBlock x:Name="OpenRouterRemaining" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" Visibility="Collapsed" />
                        </StackPanel>
                        <TextBlock x:Name="OpenRouterMessage" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,11,0,0" Visibility="Collapsed" />
                    </StackPanel>

                    <!-- CPU -->
                    <StackPanel x:Name="CpuCard" Visibility="Collapsed">
                        <DockPanel>
                            <TextBlock x:Name="CpuSince" DockPanel.Dock="Right" Style="{StaticResource SecondaryText}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{x:Static ui:Icons.CpuImage}" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock x:Name="CpuTitle" Text="CPU" Style="{StaticResource CardTitle}" Margin="9,0,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <StackPanel Margin="0,11,0,0">
                            <TextBlock Text="Temperatura" Style="{StaticResource RowLabel}" />
                            <ui:LinearBar x:Name="TempBar" Height="4" Margin="0,6,0,0" />
                            <TextBlock x:Name="TempValue" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />

                            <TextBlock Text="Máxima de la sesión" Style="{StaticResource RowLabel}" Margin="0,11,0,0" />
                            <ui:LinearBar x:Name="MaxBar" Height="4" Margin="0,6,0,0" />
                            <TextBlock x:Name="MaxValue" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />

                            <TextBlock Text="Carga de CPU" Style="{StaticResource RowLabel}" Margin="0,11,0,0" />
                            <ui:LinearBar x:Name="LoadBar" Height="4" Margin="0,6,0,0" />
                            <TextBlock x:Name="LoadValue" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                        </StackPanel>

                        <TextBlock x:Name="CpuMessage" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                   Margin="0,14,0,0" Visibility="Collapsed" />
                    </StackPanel>

                    <!-- GPU (NVIDIA) -->
                    <StackPanel x:Name="GpuCard" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{x:Static ui:Icons.GpuImage}" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock x:Name="GpuTitle" Text="GPU" Style="{StaticResource CardTitle}" Margin="9,0,0,0" />
                        </StackPanel>

                        <StackPanel Margin="0,11,0,0">
                            <TextBlock Text="Temperatura" Style="{StaticResource RowLabel}" />
                            <ui:LinearBar x:Name="GpuTempBar" Height="4" Margin="0,6,0,0" />
                            <TextBlock x:Name="GpuTempValue" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />

                            <TextBlock Text="Uso" Style="{StaticResource RowLabel}" Margin="0,11,0,0" />
                            <ui:LinearBar x:Name="GpuLoadBar" Height="4" Margin="0,6,0,0" />
                            <TextBlock x:Name="GpuLoadValue" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />

                            <!-- Only when the GPU exposes "GPU Memory Used"; the bar needs "GPU Memory Total" too. -->
                            <StackPanel x:Name="GpuMemoryRow" Visibility="Collapsed">
                                <TextBlock Text="Memoria usada" Style="{StaticResource RowLabel}" Margin="0,11,0,0" />
                                <ui:LinearBar x:Name="GpuMemoryBar" Height="4" Margin="0,6,0,0" />
                                <TextBlock x:Name="GpuMemoryValue" Text="--" Style="{StaticResource ValueText}" Margin="0,5,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock x:Name="GpuMessage" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                   Margin="0,14,0,0" Visibility="Collapsed" />
                    </StackPanel>

                </Grid>
            </Border>
        </Grid>

        <!-- Panel: a pure black tab whose concave flares (38 above and below the body) melt into the screen edge. -->
        <Grid x:Name="EdgePanel" Width="94">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="PanelShift" X="94" />
            </Grid.RenderTransform>

            <ui:EdgeTabShape Fill="#000000" CornerRadius="32" FlareHeight="38" />

            <Grid x:Name="PanelRoot" Margin="0,38,0,38">
                <StackPanel x:Name="PanelStack" Margin="0,30,0,10">
                    <!-- Which window the AI rings show: short ("Sesión") or long ("Total"). Remembered in settings;
                         hidden while no Claude, Codex or Cursor ring is shown. -->
                    <StackPanel x:Name="UsageTabs" Orientation="Horizontal" HorizontalAlignment="Center">
                        <RadioButton x:Name="SessionTab" Style="{StaticResource PanelTab}" Content="Sesión" GroupName="UsageView"
                                     AutomationProperties.AutomationId="SessionTab" Checked="OnUsageViewChecked" />
                        <RadioButton x:Name="TotalTab" Style="{StaticResource PanelTab}" Content="Total" GroupName="UsageView"
                                     AutomationProperties.AutomationId="TotalTab" Margin="10,0,0,0" Checked="OnUsageViewChecked" />
                    </StackPanel>

                    <!-- Un clic renueva la sesión de Claude y abre Claude Code (ver App.RenewClaudeSession). -->
                    <Grid x:Name="ClaudeItem" Background="Transparent" Cursor="Hand" Margin="0,12,0,0"
                          ToolTip="Renovar la sesión de Claude y abrir Claude Code"
                          MouseLeftButtonUp="OnClaudeClick">
                        <StackPanel>
                            <ui:RingGauge x:Name="ClaudeRing" Style="{StaticResource PanelRing}" Icon="{x:Static ui:Icons.ClaudeSpark}">
                                <ui:RingGauge.RenderTransform>
                                    <ScaleTransform />
                                </ui:RingGauge.RenderTransform>
                            </ui:RingGauge>
                            <TextBlock x:Name="ClaudeLabel" Text="--" Style="{StaticResource RingLabel}" />
                        </StackPanel>
                    </Grid>

                    <!-- Hidden when Codex/ChatGPT is not installed (see AiDetector). -->
                    <Grid x:Name="CodexItem" Background="Transparent" Margin="0,12,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <ui:RingGauge x:Name="CodexRing" Style="{StaticResource PanelRing}" Icon="{x:Static ui:Icons.Codex}">
                                <ui:RingGauge.RenderTransform>
                                    <ScaleTransform />
                                </ui:RingGauge.RenderTransform>
                            </ui:RingGauge>
                            <TextBlock x:Name="CodexLabel" Text="--" Style="{StaticResource RingLabel}" />
                        </StackPanel>
                    </Grid>

                    <!-- Hidden when Cursor is not installed (see AiDetector). -->
                    <Grid x:Name="CursorItem" Background="Transparent" Margin="0,12,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <ui:RingGauge x:Name="CursorRing" Style="{StaticResource PanelRing}" Icon="{x:Static ui:Icons.Cursor}">
                                <ui:RingGauge.RenderTransform><ScaleTransform /></ui:RingGauge.RenderTransform>
                            </ui:RingGauge>
                            <TextBlock x:Name="CursorLabel" Text="--" Style="{StaticResource RingLabel}" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="OpenCodeItem" Background="Transparent" Margin="0,12,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <ui:RingGauge x:Name="OpenCodeRing" Style="{StaticResource PanelRing}" Icon="{x:Static ui:Icons.OpenCode}">
                                <ui:RingGauge.RenderTransform><ScaleTransform /></ui:RingGauge.RenderTransform>
                            </ui:RingGauge>
                            <TextBlock x:Name="OpenCodeLabel" Text="--" Style="{StaticResource RingLabel}" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="DeepSeekItem" Background="Transparent" Margin="0,12,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <ui:RingGauge x:Name="DeepSeekRing" Style="{StaticResource PanelRing}" Icon="{x:Static ui:Icons.DeepSeek}">
                                <ui:RingGauge.RenderTransform><ScaleTransform /></ui:RingGauge.RenderTransform>
                            </ui:RingGauge>
                            <TextBlock x:Name="DeepSeekLabel" Text="--" Style="{StaticResource RingLabel}" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="OpenRouterItem" Background="Transparent" Margin="0,12,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <ui:RingGauge x:Name="OpenRouterRing" Style="{StaticResource PanelRing}" Icon="{x:Static ui:Icons.OpenRouter}">
                                <ui:RingGauge.RenderTransform><ScaleTransform /></ui:RingGauge.RenderTransform>
                            </ui:RingGauge>
                            <TextBlock x:Name="OpenRouterLabel" Text="--" Style="{StaticResource RingLabel}" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="CpuItem" Background="Transparent" Margin="0,12,0,0">
                        <StackPanel>
                            <ui:RingGauge x:Name="CpuRing" Style="{StaticResource PanelRing}" Icon="{x:Static ui:Icons.Cpu}">
                                <ui:RingGauge.RenderTransform>
                                    <ScaleTransform />
                                </ui:RingGauge.RenderTransform>
                            </ui:RingGauge>
                            <TextBlock x:Name="CpuLabel" Text="--" Style="{StaticResource RingLabel}" />
                        </StackPanel>
                    </Grid>

                    <!-- Hidden until an NVIDIA GPU is detected (see HardwareSensorService). -->
                    <Grid x:Name="GpuItem" Background="Transparent" Margin="0,12,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <ui:RingGauge x:Name="GpuRing" Style="{StaticResource PanelRing}" Icon="{x:Static ui:Icons.Gpu}">
                                <ui:RingGauge.RenderTransform>
                                    <ScaleTransform />
                                </ui:RingGauge.RenderTransform>
                            </ui:RingGauge>
                            <TextBlock x:Name="GpuLabel" Text="--" Style="{StaticResource RingLabel}" />
                        </StackPanel>
                    </Grid>

                    <!-- Same button, same place in both modes: "Ocultar" when pinned, "Fijar" in auto (label set in code). -->
                    <Button x:Name="ModeButton" Style="{StaticResource PanelTextButton}" Content="Ocultar"
                            AutomationProperties.AutomationId="ModeButton"
                            HorizontalAlignment="Center" Margin="0,10,0,0" Click="OnModeClick" />

                    <!-- Refreshes CPU, GPU, Claude and Codex; reads "Actualizando" and is disabled until that finishes. -->
                    <Button x:Name="RefreshButton" Style="{StaticResource PanelTextButton}" Content="Actualizar"
                            AutomationProperties.AutomationId="PanelRefreshButton"
                            HorizontalAlignment="Center" Click="OnRefreshClick" />

                </StackPanel>

                <!-- Quits the whole application, like "Salir" in the tray menu. -->
                <Button x:Name="CloseButton" Style="{StaticResource PanelCloseButton}"
                        AutomationProperties.AutomationId="CloseButton" AutomationProperties.Name="Cerrar"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,9,0" Click="OnCloseClick" />
            </Grid>
        </Grid>

    </Canvas>
</Window>
