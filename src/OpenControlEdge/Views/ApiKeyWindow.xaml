<Window x:Class="OpenControlEdge.Views.ApiKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Keys.Title}" Width="390" SizeToContent="Height" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" Background="{DynamicResource Theme.Menu}" Foreground="{DynamicResource Theme.Text}"
        FontFamily="{StaticResource UiFont}" ShowInTaskbar="False" Topmost="True">
    <Window.Resources>
        <Style x:Key="KeyAction" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/><Setter Property="Background" Value="{DynamicResource Theme.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="22">
        <TextBlock Text="{DynamicResource Keys.Title}" FontSize="19" FontWeight="SemiBold" />
        <TextBlock Text="{DynamicResource Keys.Intro}"
                   Foreground="{DynamicResource Theme.TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,17" />

        <TextBlock Text="DeepSeek" FontWeight="SemiBold" />
        <PasswordBox x:Name="DeepSeekKey" Margin="0,7,0,6" Padding="8" Background="{DynamicResource Theme.Surface}"
                     Foreground="{DynamicResource Theme.Text}" BorderBrush="{DynamicResource Theme.Border}" />
        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource KeyAction}" Content="{DynamicResource Keys.Save}" Click="OnSaveDeepSeek" />
            <Button Style="{StaticResource KeyAction}" Content="{DynamicResource Keys.Delete}" Click="OnDeleteDeepSeek" />
            <TextBlock x:Name="DeepSeekStatus" Foreground="{DynamicResource Theme.TextSecondary}" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Text="OpenRouter" FontWeight="SemiBold" Margin="0,18,0,0" />
        <PasswordBox x:Name="OpenRouterKey" Margin="0,7,0,6" Padding="8" Background="{DynamicResource Theme.Surface}"
                     Foreground="{DynamicResource Theme.Text}" BorderBrush="{DynamicResource Theme.Border}" />
        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource KeyAction}" Content="{DynamicResource Keys.Save}" Click="OnSaveOpenRouter" />
            <Button Style="{StaticResource KeyAction}" Content="{DynamicResource Keys.Delete}" Click="OnDeleteOpenRouter" />
            <TextBlock x:Name="OpenRouterStatus" Foreground="{DynamicResource Theme.TextSecondary}" VerticalAlignment="Center" />
        </StackPanel>

        <Button Content="{DynamicResource Keys.Close}" HorizontalAlignment="Right" Margin="0,20,0,0" Padding="14,7" Click="OnClose" />
    </StackPanel>
</Window>
