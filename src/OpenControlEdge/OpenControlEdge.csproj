<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>OpenControlEdge</AssemblyName>
    <RootNamespace>OpenControlEdge</RootNamespace>
    <StartupObject>OpenControlEdge.Program</StartupObject>
    <Version>2.2.0</Version>
    <!-- Version resource: SignPath Foundation requires the product name to be the project's name and the same product
         version in every build (no "+commit" suffix); its artifact configuration enforces both. -->
    <Product>Open Control Edge</Product>
    <AssemblyTitle>Open Control Edge</AssemblyTitle>
    <Company>Open Control Edge</Company>
    <Copyright>Copyright (c) 2026 danielfinchdev</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Debug runs unelevated so the UI can be iterated without UAC; Release requires administrator. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <ApplicationManifest>app.debug.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <!-- Start-up measured 2026-09-29 (see CHANGELOG 2.1.0): uncompressed + ReadyToRun paints in ~0.8 s warm and
         ~1.5 s on the first run with ~150 MB working set, against ~1.4 s / 2.2 s and ~260 MB compressed (the compressed
         bundle is inflated into memory at every start). The ZIP grows from 60 to 67 MB. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Outfit (SIL OFL 1.1, see Assets/Fonts/OFL.txt): the static 400, 500 and 600 instances of the official release,
       github.com/Outfitio/Outfit-Fonts fonts/ttf (WPF cannot select weights inside the variable font). -->
  <ItemGroup>
    <Resource Include="Assets\Fonts\Outfit-Regular.ttf" />
    <Resource Include="Assets\Fonts\Outfit-Medium.ttf" />
    <Resource Include="Assets\Fonts\Outfit-SemiBold.ttf" />
    <!-- Shown in the welcome / install window. -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <!-- Only the file generated under obj\ is compiled (see OceNativeLibraryHashes). -->
  <ItemGroup>
    <Compile Remove="NativeLibraries.g.cs" />
  </ItemGroup>

  <!-- The native libraries published next to the exe (IncludeNativeLibrariesForSelfExtract is false) and the SHA-256 of
       the very files this build publishes, compiled into the exe (NativeLibraries.Sha256 in NativeLibraries.g.cs): the
       installer copies exactly these files and only when their bytes match. A self-contained build fails if any is
       missing. Debug is not self-contained: the table is empty there. -->
  <PropertyGroup>
    <OceNativeLibraries>D3DCompiler_47_cor3.dll;PenImc_cor3.dll;PresentationNative_cor3.dll;vcruntime140_cor3.dll;wpfgfx_cor3.dll;e_sqlite3.dll;MonoPosixHelper.dll;libMonoPosixHelper.dll</OceNativeLibraries>
  </PropertyGroup>

  <Target Name="OceNativeLibraryHashes" BeforeTargets="CoreCompile" DependsOnTargets="ResolvePackageAssets;ResolveRuntimePackAssets">
    <!-- Here, not at evaluation: IntermediateOutputPath is only set once the SDK targets are imported. -->
    <PropertyGroup>
      <OceNativeLibrariesFile>$(ProjectDir)$(IntermediateOutputPath)NativeLibraries.g.cs</OceNativeLibrariesFile>
    </PropertyGroup>
    <Error Condition="'$(IntermediateOutputPath)' == ''" Text="IntermediateOutputPath vacío: no se genera NativeLibraries.g.cs." />
    <ItemGroup>
      <_OceExpected Include="$(OceNativeLibraries)" />
      <_OceCandidate Include="@(NativeCopyLocalItems);@(RuntimePackAsset)" Condition="'$(SelfContained)' == 'true'" />
      <_OceNative Include="@(_OceCandidate)" Condition="$([System.String]::Copy(';$(OceNativeLibraries);').Contains(';%(Filename)%(Extension);'))" />
    </ItemGroup>
    <GetFileHash Files="@(_OceNative)" Algorithm="SHA256" HashEncoding="hex" Condition="'@(_OceNative)' != ''">
      <Output TaskParameter="Items" ItemName="_OceNativeHashed" />
    </GetFileHash>
    <Error Condition="'$(SelfContained)' == 'true' and '@(_OceNativeHashed->Count())' != '@(_OceExpected->Count())'"
           Text="Se esperaban las librerías nativas $(OceNativeLibraries) y se han encontrado: @(_OceNativeHashed->'%(Filename)%(Extension)')" />
    <ItemGroup>
      <_OceSource Include="// &lt;auto-generated/&gt; OceNativeLibraryHashes in OpenControlEdge.csproj." />
      <_OceSource Include="namespace OpenControlEdge.Services%3B" />
      <_OceSource Include="internal static partial class NativeLibraries" />
      <_OceSource Include="{" />
      <_OceSource Include="internal static readonly System.Collections.Generic.IReadOnlyDictionary&lt;string, string&gt; Sha256 = new System.Collections.Generic.Dictionary&lt;string, string&gt;(System.StringComparer.OrdinalIgnoreCase)" />
      <_OceSource Include="{" />
      <_OceSource Include="@(_OceNativeHashed->'[&quot;%(Filename)%(Extension)&quot;] = &quot;%(FileHash)&quot;,')" />
      <_OceSource Include="}%3B" />
      <_OceSource Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(OceNativeLibrariesFile)" Lines="@(_OceSource)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <!-- WPF compiles twice (the markup pass, which already receives the file, and the real one): add it once. -->
    <ItemGroup>
      <_OceGenerated Include="@(Compile)" Condition="'%(Filename)%(Extension)' == 'NativeLibraries.g.cs'" />
      <Compile Include="$(OceNativeLibrariesFile)" Condition="'@(_OceGenerated)' == ''" />
      <FileWrites Include="$(OceNativeLibrariesFile)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <!-- SQLite through SQLitePCLRaw's raw API only (UntrustedSqlite): Microsoft.Data.Sqlite 10 still pins SQLitePCLRaw 2.x. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

</Project>
