<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Oce.Accent" Color="#6366F1" />
    <SolidColorBrush x:Key="Oce.Danger" Color="#EF4444" />
    <SolidColorBrush x:Key="Oce.Success" Color="#22C55E" />
    <Style x:Key="Oce.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="Oce.Separator" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Theme.Border}" />
        <Setter Property="Margin" Value="0,10,0,10" />
    </Style>
    <Style x:Key="Oce.Badge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Theme.Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="99" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="Oce.Radio" TargetType="RadioButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="RadioCard" Background="Transparent" BorderBrush="{DynamicResource Theme.Border}"
                            BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="RadioCard" Property="BorderBrush" Value="{StaticResource Oce.Accent}" /><Setter TargetName="RadioCard" Property="Background" Value="{DynamicResource Theme.Raised}" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RadioCard" Property="Opacity" Value="0.85" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Oce.SampleChoice" TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ChoiceCard" Background="Transparent" BorderBrush="{DynamicResource Theme.Border}"
                            BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="ChoiceCard" Property="BorderBrush" Value="{StaticResource Oce.Accent}" /><Setter TargetName="ChoiceCard" Property="Background" Value="{DynamicResource Theme.Raised}" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChoiceCard" Property="Opacity" Value="0.85" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Oce.Led" TargetType="Ellipse">
        <Setter Property="Width" Value="9" />
        <Setter Property="Height" Value="9" />
        <Setter Property="Fill" Value="{StaticResource Oce.Danger}" />
        <Setter Property="Effect">
            <Setter.Value><DropShadowEffect Color="#EF4444" BlurRadius="8" ShadowDepth="0" Opacity="0.75" /></Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Oce.Led.On" TargetType="Ellipse" BasedOn="{StaticResource Oce.Led}">
        <Setter Property="Fill" Value="{StaticResource Oce.Success}" />
        <Setter Property="Effect">
            <Setter.Value><DropShadowEffect Color="#22C55E" BlurRadius="8" ShadowDepth="0" Opacity="0.75" /></Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Oce.ButtonBase" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="Background" Value="{DynamicResource Theme.Button}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Margin" Value="0,4,7,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.83" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.68" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Oce.Button.Primary" TargetType="Button" BasedOn="{StaticResource Oce.ButtonBase}">
        <Setter Property="Background" Value="{StaticResource Oce.Accent}" /><Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource Oce.Accent}" />
    </Style>
    <Style x:Key="Oce.Button.Secondary" TargetType="Button" BasedOn="{StaticResource Oce.ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Theme.Raised}" />
    </Style>
    <Style x:Key="Oce.Button.Outline" TargetType="Button" BasedOn="{StaticResource Oce.ButtonBase}">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style x:Key="Oce.Button.Destructive" TargetType="Button" BasedOn="{StaticResource Oce.ButtonBase}">
        <Setter Property="Background" Value="{StaticResource Oce.Danger}" /><Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource Oce.Danger}" />
    </Style>
    <Style x:Key="Oce.Button.Ghost" TargetType="Button" BasedOn="{StaticResource Oce.ButtonBase}">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style x:Key="Oce.Switch" TargetType="ToggleButton">
        <Setter Property="Width" Value="40" /><Setter Property="Height" Value="23" /><Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Track" Width="40" Height="23" CornerRadius="12" Background="{DynamicResource Theme.Raised}"
                                BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" />
                        <Ellipse x:Name="Thumb" Width="17" Height="17" Fill="{DynamicResource Theme.TextSecondary}"
                                 HorizontalAlignment="Left" Margin="3,0,0,0">
                            <Ellipse.RenderTransform><TranslateTransform x:Name="ThumbMove" /></Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Oce.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Oce.Accent}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="White" />
                            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ThumbMove"
                                Storyboard.TargetProperty="X" To="17" Duration="0:0:0.13" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ThumbMove"
                                Storyboard.TargetProperty="X" To="0" Duration="0:0:0.13" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Oce.Select" TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource Theme.Button}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="SelectBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" />
                        <DockPanel Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
                            <TextBlock DockPanel.Dock="Right" Text="⌄" Foreground="{TemplateBinding Foreground}" Margin="8,0,2,0" />
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </DockPanel>
                        <ToggleButton Focusable="False" Background="Transparent" BorderThickness="0"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                            <Border Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}"
                                    BorderThickness="1" CornerRadius="7" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="240"><ItemsPresenter /></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectBorder" Property="BorderBrush" Value="{StaticResource Oce.Accent}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SelectBorder" Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Oce.Select.Item" TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{DynamicResource Theme.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style x:Key="Oce.Textarea" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Theme.Button}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8" />
    </Style>
    <Style x:Key="Oce.SliderTrack" TargetType="RepeatButton">
        <Setter Property="Background" Value="{DynamicResource Theme.Raised}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="4" Background="{TemplateBinding Background}" CornerRadius="2" VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Oce.SliderTrack.Active" TargetType="RepeatButton" BasedOn="{StaticResource Oce.SliderTrack}">
        <Setter Property="Background" Value="{StaticResource Oce.Accent}" />
    </Style>
    <Style x:Key="Oce.ScaleSlider" TargetType="Slider">
        <Setter Property="Minimum" Value="0.6" /><Setter Property="Maximum" Value="1.6" /><Setter Property="TickFrequency" Value="0.1" />
        <Setter Property="IsSnapToTickEnabled" Value="True" /><Setter Property="Foreground" Value="{StaticResource Oce.Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="24">
                        <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource Oce.SliderTrack.Active}" IsHitTestVisible="False" Height="4" /></Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource Oce.SliderTrack}" IsHitTestVisible="False" Height="4" /></Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="16" Height="16" OverridesDefaultStyle="True">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{StaticResource Oce.Accent}" BorderBrush="{DynamicResource Theme.Background}"
                                                    BorderThickness="2" CornerRadius="8" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton><RepeatButton Style="{x:Null}" IsHitTestVisible="False" Opacity="0" /></Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb MinHeight="28" OverridesDefaultStyle="True">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="{DynamicResource Theme.TextSecondary}" CornerRadius="4" Opacity="0.7" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Style="{x:Null}" IsHitTestVisible="False" Opacity="0" /></Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
