<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Controls of the settings window, after shadcn/ui (zinc, neutral). The "Set.*" colours below are the dark set;
         SettingsWindow replaces them in its own resources for the light theme. -->
    <SolidColorBrush x:Key="Set.Background" Color="#09090B" />
    <SolidColorBrush x:Key="Set.Card" Color="#18181B" />
    <SolidColorBrush x:Key="Set.Border" Color="#27272A" />
    <SolidColorBrush x:Key="Set.Input" Color="#3F3F46" />
    <SolidColorBrush x:Key="Set.Ring" Color="#71717A" />
    <SolidColorBrush x:Key="Set.Foreground" Color="#FAFAFA" />
    <SolidColorBrush x:Key="Set.Muted" Color="#A1A1AA" />
    <SolidColorBrush x:Key="Set.Secondary" Color="#27272A" />
    <SolidColorBrush x:Key="Set.SecondaryHover" Color="#3F3F46" />
    <SolidColorBrush x:Key="Set.Primary" Color="#FAFAFA" />
    <SolidColorBrush x:Key="Set.PrimaryForeground" Color="#18181B" />
    <SolidColorBrush x:Key="Set.PrimaryHover" Color="#E4E4E7" />
    <SolidColorBrush x:Key="Set.Destructive" Color="#DC2626" />
    <SolidColorBrush x:Key="Set.DestructiveHover" Color="#B91C1C" />
    <SolidColorBrush x:Key="Oce.Danger" Color="#EF4444" />
    <SolidColorBrush x:Key="Oce.Success" Color="#22C55E" />
    <SolidColorBrush x:Key="Oce.Warning" Color="#F59E0B" />

    <Style x:Key="Oce.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Set.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Set.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20,18" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
    <Style x:Key="Oce.Separator" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Set.Border}" />
        <Setter Property="Margin" Value="0,12,0,12" />
    </Style>
    <Style x:Key="Oce.Badge" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Set.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="7,2,8,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="Oce.SampleChoice" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Set.Foreground}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ChoiceCard" Background="Transparent" BorderBrush="{DynamicResource Set.Border}"
                            BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChoiceCard" Property="Background" Value="{DynamicResource Set.Secondary}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ChoiceCard" Property="BorderBrush" Value="{DynamicResource Set.Foreground}" />
                            <Setter TargetName="ChoiceCard" Property="Background" Value="{DynamicResource Set.Secondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Oce.Led" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Fill" Value="{StaticResource Oce.Danger}" />
    </Style>
    <Style x:Key="Oce.Led.On" TargetType="Ellipse" BasedOn="{StaticResource Oce.Led}">
        <Setter Property="Fill" Value="{StaticResource Oce.Success}" />
    </Style>

    <!-- Buttons: 34 high, radius 8. Hover colours are style triggers, so a local Background still wins. -->
    <Style x:Key="Oce.ButtonBase" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource Set.Foreground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Set.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"
                                          RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.5" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Oce.Button.Primary" TargetType="Button" BasedOn="{StaticResource Oce.ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Set.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Set.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Set.PrimaryForeground}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Set.PrimaryHover}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Oce.Button.Secondary" TargetType="Button" BasedOn="{StaticResource Oce.ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Set.Secondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Set.Secondary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Set.SecondaryHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Set.SecondaryHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Oce.Button.Outline" TargetType="Button" BasedOn="{StaticResource Oce.ButtonBase}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Set.Secondary}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Oce.Button.Small" TargetType="Button" BasedOn="{StaticResource Oce.Button.Outline}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style x:Key="Oce.Button.Destructive" TargetType="Button" BasedOn="{StaticResource Oce.ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Set.Destructive}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Set.Destructive}" />
        <Setter Property="Foreground" Value="White" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Set.DestructiveHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Set.DestructiveHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Oce.Button.Ghost" TargetType="Button" BasedOn="{StaticResource Oce.ButtonBase}">
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Set.Secondary}" /></Trigger>
        </Style.Triggers>
    </Style>

    <!-- Sidebar item: icon and text on the left; the active one gets a local Set.Secondary background. -->
    <Style x:Key="Oce.NavItem" TargetType="Button" BasedOn="{StaticResource Oce.Button.Ghost}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <!-- Switch: 36 × 20, the thumb sits on the right while checked and slides in 120 ms. -->
    <Style x:Key="Oce.Switch" TargetType="ToggleButton">
        <Setter Property="Width" Value="36" /><Setter Property="Height" Value="20" /><Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Track" CornerRadius="10" Background="{DynamicResource Set.Input}" />
                        <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="{DynamicResource Set.Background}"
                                 HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Set.Primary}" />
                            <Setter TargetName="Thumb" Property="Margin" Value="18,0,0,0" />
                            <Trigger.EnterActions><BeginStoryboard><Storyboard><ThicknessAnimation Storyboard.TargetName="Thumb"
                                Storyboard.TargetProperty="Margin" From="2,0,0,0" To="18,0,0,0" Duration="0:0:0.12" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard><ThicknessAnimation Storyboard.TargetName="Thumb"
                                Storyboard.TargetProperty="Margin" From="18,0,0,0" To="2,0,0,0" Duration="0:0:0.12" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Oce.Select" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Set.Foreground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Set.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="11,0,10,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="SelectBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" />
                        <DockPanel Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
                            <Path DockPanel.Dock="Right" Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource Set.Muted}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" Margin="8,1,0,0" />
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </DockPanel>
                        <ToggleButton Focusable="False" Cursor="Hand"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" /></ControlTemplate></ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                            <Border Background="{DynamicResource Set.Card}" BorderBrush="{DynamicResource Set.Border}" BorderThickness="1"
                                    CornerRadius="8" Padding="4" Margin="0,0,6,6"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" /></Border.Effect>
                                <ScrollViewer MaxHeight="240"><ItemsPresenter /></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectBorder" Property="BorderBrush" Value="{DynamicResource Set.Ring}" /></Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="SelectBorder" Property="BorderBrush" Value="{DynamicResource Set.Ring}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SelectBorder" Property="Opacity" Value="0.5" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Oce.Select.Item" TargetType="ComboBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource Set.Foreground}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemChrome" Background="Transparent" CornerRadius="6" Padding="8,6">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource Set.Secondary}" /></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text fields: transparent, hairline border, radius 8; the border lightens on hover and focus. -->
    <ControlTemplate x:Key="Oce.FieldTemplate" TargetType="Control">
        <Border x:Name="FieldBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FieldBorder" Property="BorderBrush" Value="{DynamicResource Set.Ring}" /></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FieldBorder" Property="BorderBrush" Value="{DynamicResource Set.Muted}" /></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="Oce.Textarea" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Set.Foreground}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Set.Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Set.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template" Value="{StaticResource Oce.FieldTemplate}" />
    </Style>
    <Style x:Key="Oce.Input" TargetType="TextBox" BasedOn="{StaticResource Oce.Textarea}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="Oce.Password" TargetType="PasswordBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Set.Foreground}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Set.Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Set.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource Oce.FieldTemplate}" />
    </Style>

    <Style x:Key="Oce.SliderTrack" TargetType="RepeatButton">
        <Setter Property="Background" Value="{DynamicResource Set.Secondary}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="6" Background="{TemplateBinding Background}" CornerRadius="3" VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Oce.SliderTrack.Active" TargetType="RepeatButton" BasedOn="{StaticResource Oce.SliderTrack}">
        <Setter Property="Background" Value="{DynamicResource Set.Primary}" />
    </Style>
    <Style x:Key="Oce.ScaleSlider" TargetType="Slider">
        <Setter Property="Minimum" Value="0.6" /><Setter Property="Maximum" Value="1.6" /><Setter Property="TickFrequency" Value="0.1" />
        <Setter Property="IsSnapToTickEnabled" Value="True" /><Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="24">
                        <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource Oce.SliderTrack.Active}" IsHitTestVisible="False" /></Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource Oce.SliderTrack}" IsHitTestVisible="False" /></Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="16" Height="16" OverridesDefaultStyle="True">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{DynamicResource Set.Background}" BorderBrush="{DynamicResource Set.Primary}"
                                                    BorderThickness="2" CornerRadius="8" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton><RepeatButton Style="{x:Null}" IsHitTestVisible="False" Opacity="0" /></Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb MinHeight="28" OverridesDefaultStyle="True">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="{DynamicResource Theme.TextSecondary}" CornerRadius="4" Opacity="0.7" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Style="{x:Null}" IsHitTestVisible="False" Opacity="0" /></Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
